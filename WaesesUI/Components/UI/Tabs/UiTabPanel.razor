@namespace WaesesUI
@inherits UiComponentBase
@implements IDisposable

@if (ParentTabs?.IsActive(this) == true)
{
    <div class="ui-tab-pane @Class" style="@Style" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] public UiTabs? ParentTabs { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Badge { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        ParentTabs?.AddPanel(this);
    }

    public void Dispose()
    {
        ParentTabs?.RemovePanel(this);
    }
}
