@namespace WaesesUI
@inherits UiComponentBase

<div class="ui-progress-circle-wrap @Class" style="@WrapStyle" @attributes="AdditionalAttributes">
    <svg width="@Diameter" height="@Diameter" viewBox="0 0 @Diameter @Diameter" style="transform: rotate(-90deg);">
        <!-- Background Track -->
        <circle cx="@(Diameter / 2.0)"
                cy="@(Diameter / 2.0)"
                r="@Radius"
                fill="transparent"
                stroke="var(--bg-surface-tertiary)"
                stroke-width="@StrokeWidth" />

        <!-- Fill Circle -->
        <circle cx="@(Diameter / 2.0)"
                cy="@(Diameter / 2.0)"
                r="@Radius"
                fill="transparent"
                stroke="@GetColorCss()"
                stroke-width="@StrokeWidth"
                stroke-dasharray="@Circumference"
                stroke-dashoffset="@DashOffset"
                stroke-linecap="round"
                style="transition: stroke-dashoffset 0.4s ease;" />
    </svg>

    @if (ShowValue)
    {
        <span class="ui-progress-circle-label">
            @Math.Round(ClampedValue)%
        </span>
    }
</div>

@code {
    private string? WrapStyle => StyleBuilder.Default($"width: {Diameter}px; height: {Diameter}px;").Add(Style).Build();

    [Parameter] public double Value { get; set; }
    /// <summary>Valeur correspondant à 100 %.</summary>
    [Parameter] public double Max { get; set; } = 100;
    /// <summary>Diamètre en pixels.</summary>
    [Parameter] public int Diameter { get; set; } = 72;
    /// <summary>Épaisseur du trait en pixels.</summary>
    [Parameter] public int StrokeWidth { get; set; } = 6;
    /// <summary>Couleur de l'arc.</summary>
    [Parameter] public UiColor Color { get; set; } = UiColor.Primary;
    /// <summary>Affiche le pourcentage au centre.</summary>
    [Parameter] public bool ShowValue { get; set; } = true;

    private double Radius => (Diameter - StrokeWidth) / 2.0;
    private double Circumference => 2 * Math.PI * Radius;

    private double ClampedValue
    {
        get
        {
            if (Max <= 0) return 0;
            var pct = (Value / Max) * 100;
            return Math.Clamp(pct, 0, 100);
        }
    }

    private double DashOffset => Circumference - (ClampedValue / 100.0 * Circumference);

    private string GetColorCss() => Color switch
    {
        UiColor.Primary => "var(--primary)",
        UiColor.Success => "var(--success)",
        UiColor.Danger => "var(--danger)",
        UiColor.Warning => "var(--warning)",
        UiColor.Info => "var(--info)",
        UiColor.Secondary => "var(--secondary)",
        _ => "var(--primary)"
    };
}
