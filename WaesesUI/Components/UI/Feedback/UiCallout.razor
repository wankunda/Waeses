@namespace WaesesUI
@inherits UiComponentBase

<aside class="ui-callout ui-callout-@Color.ToString().ToLower() @Class" role="note" style="@Style" @attributes="AdditionalAttributes">
    <UiIcon Icon="@Icon" Size="UiSize.Md" aria-hidden="true" />
    <div><strong>@Title</strong><div>@ChildContent</div></div>
</aside>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Icon { get; set; } = Icons.Material.Filled.Info;
    [Parameter] public UiColor Color { get; set; } = UiColor.Info;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
