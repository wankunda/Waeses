@namespace WaesesUI
@inherits UiComponentBase

<section class="ui-empty-state @Class" role="status" style="@Style" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <UiIcon Icon="@Icon" Size="UiSize.Xl" Color="@IconColor" aria-hidden="true" />
    }
    <h3>@Title</h3>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p>@Description</p>
    }
    @if (ChildContent != null)
    {
        <div class="ui-empty-state-actions">@ChildContent</div>
    }
    else if (!string.IsNullOrWhiteSpace(ActionText))
    {
        <button type="button" class="ui-btn ui-btn-outline ui-btn-md" @onclick="OnActionClick">@ActionText</button>
    }
</section>

@code {
    /// <summary>Titre de l'état vide.</summary>
    [Parameter] public string Title { get; set; } = "Aucun résultat";
    /// <summary>Texte explicatif sous le titre.</summary>
    [Parameter] public string? Description { get; set; }
    /// <summary>Icône illustrant l'état (SVG de la bibliothèque d'icônes).</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Couleur de l'icône.</summary>
    [Parameter] public UiColor IconColor { get; set; } = UiColor.Neutral;
    /// <summary>Libellé du bouton d'action. Le bouton n'apparaît que s'il est défini.</summary>
    [Parameter] public string? ActionText { get; set; }
    /// <summary>Appelé au clic sur le bouton d'action.</summary>
    [Parameter] public EventCallback OnAction { get; set; }
    /// <summary>Contenu supplémentaire affiché sous la description.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task OnActionClick() => OnAction.InvokeAsync();
}
