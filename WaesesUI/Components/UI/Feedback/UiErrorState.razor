@namespace WaesesUI
@inherits UiComponentBase

<section class="ui-error-state @Class" role="alert" style="@Style" @attributes="AdditionalAttributes">
    <UiIcon Icon="@Icons.Material.Filled.Error" Size="UiSize.Lg" Color="UiColor.Danger" aria-hidden="true" />
    <div>
        <h3>@Title</h3>
        <p>@Message</p>
    </div>
    @if (OnRetry.HasDelegate)
    {
        <button type="button" class="ui-btn ui-btn-outline ui-btn-sm" @onclick="OnRetry">@RetryText</button>
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = "Une erreur est survenue";
    [Parameter] public string Message { get; set; } = "Impossible de charger les données.";
    [Parameter] public string RetryText { get; set; } = "Réessayer";
    [Parameter] public EventCallback OnRetry { get; set; }
}
