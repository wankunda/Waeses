@namespace WaesesUI
@inherits UiComponentBase

<div class="ui-tooltip-wrapper @Class" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
    <div class="ui-tooltip-content ui-tooltip-@Position.ToString().ToLower()">
        @Text
    </div>
</div>

@code {
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public TooltipPosition Position { get; set; } = TooltipPosition.Top; // top, bottom, left, right
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
