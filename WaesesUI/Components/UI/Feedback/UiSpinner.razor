@namespace WaesesUI
@inherits UiComponentBase

@if (Variant == UiSpinnerVariant.Pulse)
{
    <div class="ui-pulse-loader @Class" style="@ColorStyle" @attributes="AdditionalAttributes">
        <div class="ui-pulse-dot"></div>
        <div class="ui-pulse-dot"></div>
        <div class="ui-pulse-dot"></div>
    </div>
}
else
{
    <span class="ui-spinner ui-spinner-@Size.ToString().ToLower() @Class"
          style="color: @GetColorCss();"
          @attributes="AdditionalAttributes"></span>
}

@code {
    private string? ColorStyle => StyleBuilder.Default($"color: {GetColorCss()};").Add(Style).Build();

    [Parameter] public UiSize Size { get; set; } = UiSize.Md;
    [Parameter] public UiColor Color { get; set; } = UiColor.Primary;
    [Parameter] public UiSpinnerVariant Variant { get; set; } = UiSpinnerVariant.Spin; // "spin" or "pulse"

    private string GetColorCss() => Color switch
    {
        UiColor.Primary => "var(--primary)",
        UiColor.Secondary => "var(--secondary)",
        UiColor.Success => "var(--success)",
        UiColor.Danger => "var(--danger)",
        UiColor.Warning => "var(--warning)",
        UiColor.Info => "var(--info)",
        UiColor.Neutral => "var(--text-muted)",
        _ => "var(--primary)"
    };
}
