@namespace WaesesUI
@inherits UiComponentBase

<CascadingValue Value="this" IsFixed="true">
    <div class="ui-accordion @Class" style="@Style" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly List<UiAccordionItem> _items = new();

    /// <summary>Autorise plusieurs éléments ouverts en même temps. Sinon, ouvrir un élément ferme les autres.</summary>
    [Parameter] public bool AllowMultiple { get; set; }
    /// <summary>Les <c>UiAccordionItem</c> du groupe.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public void RegisterItem(UiAccordionItem item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);
        }
    }

    public void ToggleItem(UiAccordionItem target)
    {
        if (!AllowMultiple)
        {
            foreach (var item in _items)
            {
                if (item != target)
                {
                    item.Collapse();
                }
            }
        }
    }
}
