@namespace WaesesUI

<CascadingValue Value="this" IsFixed="true">
    <div class="ui-accordion @Class" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly List<UiAccordionItem> _items = new();

    [Parameter] public bool AllowMultiple { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public void RegisterItem(UiAccordionItem item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);
        }
    }

    public void ToggleItem(UiAccordionItem target)
    {
        if (!AllowMultiple)
        {
            foreach (var item in _items)
            {
                if (item != target)
                {
                    item.Collapse();
                }
            }
        }
    }
}
