@namespace WaesesUI
@inherits UiComponentBase

<div class="ui-skeleton ui-skeleton-@Variant.ToString().ToLower() @Class"
     style="@StyleBuilder.Default(GetStyle()).Add(Style).Build()"
     role="status"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes"></div>

@code {
    [Parameter] public UiSkeletonVariant Variant { get; set; } = UiSkeletonVariant.Text;
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Height { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Chargement";

    private string GetStyle()
    {
        var styles = new List<string>();
        if (!string.IsNullOrWhiteSpace(Width)) styles.Add($"width: {Width};");
        if (!string.IsNullOrWhiteSpace(Height)) styles.Add($"height: {Height};");
        return string.Join(" ", styles);
    }
}
