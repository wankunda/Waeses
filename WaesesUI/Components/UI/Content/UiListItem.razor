@namespace WaesesUI
@inherits UiComponentBase

<div class="ui-list-item @Class" style="@Style" @attributes="AdditionalAttributes">
    @if (Leading != null) { <div class="ui-list-leading">@Leading</div> }
    <div class="ui-list-item-content">@ChildContent</div>
    @if (Trailing != null) { <div class="ui-list-trailing">@Trailing</div> }
</div>

@code {
    /// <summary>Contenu au début de la ligne (avatar, icône…).</summary>
    [Parameter] public RenderFragment? Leading { get; set; }
    /// <summary>Contenu principal de la ligne.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Contenu à la fin de la ligne (action, valeur…).</summary>
    [Parameter] public RenderFragment? Trailing { get; set; }
}
