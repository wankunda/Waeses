@namespace WaesesUI

<div class="ui-list-item @Class" @attributes="AdditionalAttributes">
    @if (Leading != null) { <div class="ui-list-leading">@Leading</div> }
    <div class="ui-list-item-content">@ChildContent</div>
    @if (Trailing != null) { <div class="ui-list-trailing">@Trailing</div> }
</div>

@code {
    [Parameter] public RenderFragment? Leading { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Trailing { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
