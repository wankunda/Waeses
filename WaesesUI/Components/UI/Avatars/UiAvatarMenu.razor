@namespace WaesesUI
@inherits UiComponentBase

<UiMenu AriaLabel="@MenuAriaLabel"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        Disabled="@Disabled"
        Dense="@Dense"
        CloseOnItemClick="@CloseOnItemClick"
        Alignment="@Alignment"
        MaxHeight="@MaxHeight"
        Class="@($"ui-avatar-menu {MenuClass}")"
        style="@Style" @attributes="AdditionalAttributes">
    <Trigger>
        <UiAvatar Src="@Src"
                  Alt="@Alt"
                  Initials="@Initials"
                  Size="@Size"
                  Shape="@Shape"
                  Status="@Status"
                  BackgroundColor="@BackgroundColor"
                  Class="@Class" />
    </Trigger>
    <ChildContent>
        @ChildContent
    </ChildContent>
</UiMenu>

@code {
    /// <summary>Adresse de l'image de l'avatar.</summary>
    [Parameter] public string? Src { get; set; }
    /// <summary>Texte alternatif de l'image.</summary>
    [Parameter] public string? Alt { get; set; } = "Avatar";
    /// <summary>Initiales affichées en l'absence d'image.</summary>
    [Parameter] public string? Initials { get; set; }
    /// <summary>Taille de l'avatar.</summary>
    [Parameter] public UiSize Size { get; set; } = UiSize.Md;
    /// <summary>Forme : cercle ou carré.</summary>
    [Parameter] public AvatarShape Shape { get; set; } = AvatarShape.Circle;
    /// <summary>Pastille de présence.</summary>
    [Parameter] public AvatarStatus Status { get; set; } = AvatarStatus.None;
    /// <summary>Couleur de fond CSS des initiales.</summary>
    [Parameter] public string? BackgroundColor { get; set; }
    /// <summary>Éléments du menu qui s'ouvre au clic sur l'avatar.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Classes CSS supplémentaires du menu.</summary>
    [Parameter] public string? MenuClass { get; set; }
    /// <summary>Nom accessible du menu.</summary>
    [Parameter] public string MenuAriaLabel { get; set; } = "Menu du profil";
    /// <summary>Indique si le menu est ouvert (lié avec <c>bind-IsOpen</c>).</summary>
    [Parameter] public bool IsOpen { get; set; }
    /// <summary>Appelé lorsque l'état d'ouverture du menu change.</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    /// <summary>Désactive l'avatar et son menu.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Réduit l'espacement des éléments du menu.</summary>
    [Parameter] public bool Dense { get; set; }
    /// <summary>Ferme le menu au clic sur un de ses éléments.</summary>
    [Parameter] public bool CloseOnItemClick { get; set; } = true;
    /// <summary>Bord de l'avatar sur lequel le menu s'aligne.</summary>
    [Parameter] public UiMenuAlignment Alignment { get; set; } = UiMenuAlignment.End;
    /// <summary>Hauteur maximale CSS du menu, au-delà de laquelle il défile.</summary>
    [Parameter] public string? MaxHeight { get; set; } = "20rem";
}
