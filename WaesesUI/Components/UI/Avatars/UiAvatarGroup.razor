@namespace WaesesUI
@inherits UiComponentBase

<div class="ui-avatar-group @Class" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
    @if (ExtraCount > 0)
    {
        <div class="ui-avatar ui-avatar-md ui-avatar-circle" style="background: var(--bg-surface-secondary); color: var(--text-main); font-size: 0.8rem;">
            +@ExtraCount
        </div>
    }
</div>

@code {
    /// <summary>Les <c>UiAvatar</c> du groupe, affichés en chevauchement.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Nombre d'avatars non affichés ; si supérieur à 0, une pastille « +N » est ajoutée.</summary>
    [Parameter] public int ExtraCount { get; set; }
}
