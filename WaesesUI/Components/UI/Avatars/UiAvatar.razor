@namespace WaesesUI
@inherits UiComponentBase

<div class="ui-avatar ui-avatar-@Size.ToString().ToLower() ui-avatar-@Shape.ToString().ToLower() @Class"
     style="@StyleBuilder.Default(GetCustomStyle()).Add(Style).Build()"
     @attributes="AdditionalAttributes">
    @if (!string.IsNullOrEmpty(Src) && !_imageFailed)
    {
        <img class="ui-avatar-img" src="@Src" alt="@Alt" @onerror="HandleImageError" />
    }
    else if (!string.IsNullOrEmpty(Initials))
    {
        <span class="ui-avatar-initials">@Initials</span>
    }
    else if (ChildContent != null)
    {
        @ChildContent
    }
    else
    {
        <span>👤</span>
    }

    @if (Status != AvatarStatus.None)
    {
        <span class="ui-avatar-status ui-avatar-status-@Status.ToString().ToLower()"></span>
    }
</div>

@code {
    /// <summary>Adresse de l'image. Sans image, les initiales sont affichées.</summary>
    [Parameter] public string? Src { get; set; }
    /// <summary>Texte alternatif de l'image.</summary>
    [Parameter] public string? Alt { get; set; } = "Avatar";
    /// <summary>Initiales affichées en l'absence d'image.</summary>
    [Parameter] public string? Initials { get; set; }
    /// <summary>Taille de l'avatar.</summary>
    [Parameter] public UiSize Size { get; set; } = UiSize.Md;
    /// <summary>Forme : cercle ou carré.</summary>
    [Parameter] public AvatarShape Shape { get; set; } = AvatarShape.Circle;
    /// <summary>Pastille de présence (en ligne, occupé, absent, hors ligne).</summary>
    [Parameter] public AvatarStatus Status { get; set; } = AvatarStatus.None;
    /// <summary>Couleur de fond CSS des initiales.</summary>
    [Parameter] public string? BackgroundColor { get; set; }
    /// <summary>Contenu libre à la place de l'image et des initiales.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? _lastSrc;
    private bool _imageFailed;

    protected override void OnParametersSet()
    {
        if (!string.Equals(_lastSrc, Src, StringComparison.Ordinal))
        {
            _lastSrc = Src;
            _imageFailed = false;
        }
    }

    private void HandleImageError()
    {
        _imageFailed = true;
    }

    private string GetCustomStyle()
    {
        if (!string.IsNullOrEmpty(BackgroundColor))
        {
            return $"background: {BackgroundColor};";
        }
        return string.Empty;
    }
}
