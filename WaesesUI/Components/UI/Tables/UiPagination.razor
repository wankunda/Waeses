@namespace WaesesUI

@if (TotalPages > 1 || AlwaysShow)
{
    <nav class="ui-pagination @Class" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
        @if (ShowInfo)
        {
            <span class="ui-pagination-info">@FromIndex–@ToIndex sur @TotalItems</span>
        }
        <div class="ui-pagination-nav">
            <button type="button" class="ui-pagination-btn" disabled="@(CurrentPage <= 1)" aria-label="Première page" @onclick="() => ChangePage(1)">«</button>
            <button type="button" class="ui-pagination-btn" disabled="@(CurrentPage <= 1)" aria-label="Page précédente" @onclick="() => ChangePage(CurrentPage - 1)">‹</button>
            @foreach (var pageNumber in VisiblePages)
            {
                if (pageNumber is null)
                {
                    <span class="ui-pagination-ellipsis" aria-hidden="true">...</span>
                }
                else
                {
                    <button type="button"
                            class="ui-pagination-btn @(pageNumber == CurrentPage ? "active" : "")"
                            aria-current="@(pageNumber == CurrentPage ? "page" : null)"
                            aria-label="Page @pageNumber"
                            @onclick="() => ChangePage(pageNumber.Value)">@pageNumber</button>
                }
            }
            <button type="button" class="ui-pagination-btn" disabled="@(CurrentPage >= TotalPages)" aria-label="Page suivante" @onclick="() => ChangePage(CurrentPage + 1)">›</button>
            <button type="button" class="ui-pagination-btn" disabled="@(CurrentPage >= TotalPages)" aria-label="Dernière page" @onclick="() => ChangePage(TotalPages)">»</button>
        </div>
        @if (PageSizeOptions.Count > 0)
        {
            <select class="ui-table-page-select" value="@PageSize" aria-label="Lignes par page" @onchange="ChangePageSize">
                @foreach (var option in PageSizeOptions)
                {
                    <option value="@option">@option / page</option>
                }
            </select>
        }
    </nav>
}

@code {
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public IReadOnlyList<int> PageSizeOptions { get; set; } = Array.Empty<int>();
    [Parameter] public bool ShowInfo { get; set; }
    [Parameter] public bool AlwaysShow { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Pagination";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)Math.Max(PageSize, 1)));
    private int SafePage => Math.Clamp(CurrentPage, 1, TotalPages);
    private int FromIndex => TotalItems == 0 ? 0 : ((SafePage - 1) * PageSize) + 1;
    private int ToIndex => Math.Min(SafePage * PageSize, TotalItems);

    private IEnumerable<int?> VisiblePages
    {
        get
        {
            if (TotalPages <= 7)
            {
                return Enumerable.Range(1, TotalPages).Cast<int?>();
            }

            var pages = new List<int?> { 1 };
            if (SafePage > 4) pages.Add(null);
            for (var page = Math.Max(2, SafePage - 1); page <= Math.Min(TotalPages - 1, SafePage + 1); page++) pages.Add(page);
            if (SafePage < TotalPages - 3) pages.Add(null);
            pages.Add(TotalPages);
            return pages;
        }
    }

    private async Task ChangePage(int page)
    {
        var nextPage = Math.Clamp(page, 1, TotalPages);
        if (nextPage != CurrentPage) await CurrentPageChanged.InvokeAsync(nextPage);
    }

    private async Task ChangePageSize(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var size) && size > 0)
        {
            await PageSizeChanged.InvokeAsync(size);
        }
    }
}