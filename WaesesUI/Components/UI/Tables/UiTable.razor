@typeparam TItem
@namespace WaesesUI
@inherits UiComponentBase

<CascadingValue Value="this" IsFixed="true">
    <div class="ui-table-container @Class" style="@Style" @attributes="AdditionalAttributes">
        @if (ShowSearch || ToolbarContent != null)
        {
            <div class="ui-table-toolbar">
                @if (ShowSearch)
                {
                    <div class="ui-table-search-box">
                        <span class="ui-table-search-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </span>
                        <input type="text"
                               class="ui-input"
                               placeholder="@SearchPlaceholder"
                               value="@_searchQuery"
                               @oninput="HandleSearchInput" />
                    </div>
                }
                @if (ToolbarContent != null)
                {
                    <div class="ui-flex-row">
                        @ToolbarContent
                    </div>
                }
            </div>
        }

        <div class="ui-table-responsive">
            <table class="ui-table @(Striped ? "ui-table-striped" : "") @(Hoverable ? "ui-table-hover" : "") @(Bordered ? "ui-table-bordered" : "") @(Compact ? "ui-table-compact" : "")">
                @if (HeaderContent != null || Selectable)
                {
                    <thead>
                        <tr>
                            @if (Selectable)
                            {
                                <th style="width: 44px; text-align: center;">
                                    <input type="checkbox"
                                           checked="@IsAllSelected"
                                           @onchange="ToggleSelectAll"
                                           style="cursor: pointer; width: 16px; height: 16px; accent-color: var(--primary);" />
                                </th>
                            }
                            @HeaderContent
                        </tr>
                    </thead>
                }
                <tbody>
                    @if (IsLoading)
                    {
                        <tr><td colspan="100" class="ui-table-state"><UiSkeleton Variant="UiSkeletonVariant.Rect" Height="8rem" /></td></tr>
                    }
                    else if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <tr><td colspan="100" class="ui-table-state"><UiErrorState Message="@ErrorMessage" OnRetry="OnRetry" /></td></tr>
                    }
                    else if (ProcessedItems.Any())
                    {
                        @foreach (var item in DisplayedItems)
                        {
                            var isSelected = SelectedItems != null && SelectedItems.Contains(item);
                            <tr class="@(isSelected ? "ui-table-row-selected" : "")" @onclick="() => HandleRowClick(item)">
                                @if (Selectable)
                                {
                                    <td style="width: 44px; text-align: center;" @onclick:stopPropagation="true">
                                        <input type="checkbox"
                                               checked="@isSelected"
                                               @onchange="() => ToggleSelectItem(item)"
                                               style="cursor: pointer; width: 16px; height: 16px; accent-color: var(--primary);" />
                                    </td>
                                }
                                @if (RowTemplate != null)
                                {
                                    @RowTemplate(item)
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="100" class="ui-table-empty">
                                @if (EmptyContent != null)
                                {
                                    @EmptyContent
                                }
                                else
                                {
                                    <UiEmptyState Title="@EmptyText" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Paginated && ProcessedItems.Any())
        {
            <UiPagination TotalItems="@TotalCount"
                          CurrentPage="@CurrentPage"
                          CurrentPageChanged="SetPage"
                          PageSize="@PageSize"
                          PageSizeChanged="HandlePageSizeChanged"
                          PageSizeOptions="@PageSizeOptions"
                          ShowInfo="true"
                          AlwaysShow="true" />
        }
    </div>
</CascadingValue>

@code {
    private string _searchQuery = string.Empty;

    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment<TItem>? RowTemplate { get; set; }
    [Parameter] public RenderFragment? ToolbarContent { get; set; }
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    [Parameter] public string EmptyText { get; set; } = "Aucune donnée disponible";
    [Parameter] public bool Striped { get; set; } = true;
    [Parameter] public bool Hoverable { get; set; } = true;
    [Parameter] public bool Bordered { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool ShowSearch { get; set; }
    [Parameter] public string SearchPlaceholder { get; set; } = "Rechercher...";
    [Parameter] public Func<TItem, string, bool>? FilterPredicate { get; set; }
    [Parameter] public bool Paginated { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public IReadOnlyList<int> PageSizeOptions { get; set; } = new[] { 5, 10, 25, 50 };
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }
    [Parameter] public bool Selectable { get; set; }
    [Parameter] public HashSet<TItem>? SelectedItems { get; set; }
    [Parameter] public EventCallback<HashSet<TItem>> SelectedItemsChanged { get; set; }
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }

    public Func<TItem, object>? CurrentSortSelector { get; private set; }
    public string? CurrentSortKey { get; private set; }
    public bool IsSortAscending { get; private set; } = true;

    private IEnumerable<TItem> ProcessedItems
    {
        get
        {
            if (Items == null) return Enumerable.Empty<TItem>();

            var list = Items;

            // 1. Filtrage / Recherche
            if (ShowSearch && !string.IsNullOrWhiteSpace(_searchQuery))
            {
                if (FilterPredicate != null)
                {
                    list = list.Where(item => FilterPredicate(item, _searchQuery));
                }
                else
                {
                    list = list.Where(item => item?.ToString()?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false);
                }
            }

            // 2. Tri
            if (CurrentSortSelector != null)
            {
                list = IsSortAscending
                    ? list.OrderBy(CurrentSortSelector)
                    : list.OrderByDescending(CurrentSortSelector);
            }

            return list;
        }
    }

    private IEnumerable<TItem> DisplayedItems
    {
        get
        {
            var processed = ProcessedItems;
            if (!Paginated) return processed;

            return processed.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
        }
    }

    private int TotalCount => ProcessedItems.Count();

    private bool IsAllSelected
    {
        get
        {
            var current = DisplayedItems.ToList();
            return current.Any() && SelectedItems != null && current.All(item => SelectedItems.Contains(item));
        }
    }

    public async Task SetSortAsync(Func<TItem, object> selector, string? sortKey)
    {
        if (CurrentSortSelector == selector)
        {
            IsSortAscending = !IsSortAscending;
        }
        else
        {
            CurrentSortSelector = selector;
            CurrentSortKey = sortKey;
            IsSortAscending = true;
        }
        CurrentPage = 1;
        await CurrentPageChanged.InvokeAsync(CurrentPage);
        StateHasChanged();
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        PageSize = newSize;
        CurrentPage = 1;
        await CurrentPageChanged.InvokeAsync(CurrentPage);
    }

    private async Task SetPage(int page)
    {
        if (CurrentPage != page)
        {
            CurrentPage = page;
            await CurrentPageChanged.InvokeAsync(CurrentPage);
        }
    }

    private async Task HandleRowClick(TItem item)
    {
        await OnRowClick.InvokeAsync(item);
    }

    private async Task ToggleSelectItem(TItem item)
    {
        SelectedItems ??= new HashSet<TItem>();
        if (SelectedItems.Contains(item))
        {
            SelectedItems.Remove(item);
        }
        else
        {
            SelectedItems.Add(item);
        }
        await SelectedItemsChanged.InvokeAsync(SelectedItems);
    }

    private async Task ToggleSelectAll(ChangeEventArgs e)
    {
        SelectedItems ??= new HashSet<TItem>();
        var isChecked = (bool)(e.Value ?? false);
        var displayed = DisplayedItems.ToList();

        if (isChecked)
        {
            foreach (var item in displayed)
            {
                SelectedItems.Add(item);
            }
        }
        else
        {
            foreach (var item in displayed)
            {
                SelectedItems.Remove(item);
            }
        }
        await SelectedItemsChanged.InvokeAsync(SelectedItems);
    }

}
