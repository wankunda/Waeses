@namespace WaesesUI
@inherits UiComponentBase

<UiMenu Trigger="@Trigger"
        ChildContent="@ChildContent"
        AriaLabel="@AriaLabel"
        IsOpen="@IsOpen"
        IsOpenChanged="@IsOpenChanged"
        Class="@($"ui-dropdown {Class}")"
        style="@Style" @attributes="AdditionalAttributes" />

@code {
    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Menu d'actions";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
}
