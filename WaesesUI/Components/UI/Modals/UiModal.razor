@namespace WaesesUI
@inherits UiComponentBase
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (IsOpen)
{
    <div class="@UiDialogCss.BackdropClass(Position, FullScreen, BackdropClass)"
         @onclick="HandleBackdropClick"
         @ref="_backdropRef">
        <div class="@UiDialogCss.BoxClass(Size, FullScreen, Class)"
             style="@StyleBuilder.Default(UiDialogCss.WidthStyle(Size, FullScreen)).Add(Style).Build()"
             @onclick:stopPropagation="true"
             @ref="_modalRef"
             tabindex="-1"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             @attributes="AdditionalAttributes">

            @if (Header != null || !string.IsNullOrEmpty(Title) || ShowCloseButton)
            {
                <div class="ui-modal-header">
                    @if (Header != null)
                    {
                        @Header
                    }
                    else
                    {
                        <div id="@_titleId" class="ui-modal-title h6">@Title</div>
                    }

                    @if (ShowCloseButton)
                    {
                        <button type="button"
                                class="ui-modal-close-btn"
                                aria-label="Fermer"
                                @onclick="CloseAsync">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    }
                </div>
            }

            <div class="ui-modal-body">
                @ChildContent
            </div>

            @if (Footer != null)
            {
                <div class="ui-modal-footer">
                    @Footer
                </div>
            }
        </div>
    </div>
}

@code {
    private ElementReference _modalRef;
    private ElementReference _backdropRef;
    private DotNetObjectReference<UiModal>? _dotNetRef;
    private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";
    private bool _isSetUp;

    /// <summary>Indique si la modale est ouverte (lié avec <c>bind-IsOpen</c>).</summary>
    [Parameter] public bool IsOpen { get; set; }
    /// <summary>Appelé lorsque la modale demande sa fermeture (fond, Échap, bouton de fermeture).</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    /// <summary>Titre affiché dans l'en-tête, et nom accessible de la modale.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>En-tête personnalisé (remplace <c>Title</c>).</summary>
    [Parameter] public RenderFragment? Header { get; set; }
    /// <summary>Contenu de la modale.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Pied de la modale, généralement les boutons d'action.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>Largeur de la modale.</summary>
    [Parameter] public UiSize Size { get; set; } = UiSize.Md;
    /// <summary>Ferme la modale au clic sur le fond assombri.</summary>
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    /// <summary>Ferme la modale avec la touche Échap.</summary>
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    /// <summary>Garde le focus clavier dans la modale et le rend au déclencheur à la fermeture.</summary>
    [Parameter] public bool FocusTrap { get; set; } = true;
    /// <summary>Bloque le défilement de la page tant que la modale est ouverte.</summary>
    [Parameter] public bool LockScroll { get; set; } = true;
    /// <summary>Affiche le bouton de fermeture dans l'en-tête.</summary>
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    /// <summary>Position de la modale dans la fenêtre.</summary>
    [Parameter] public UiDialogPosition Position { get; set; } = UiDialogPosition.Center;
    /// <summary>Occupe tout l'écran, sans marge ni coins arrondis.</summary>
    [Parameter] public bool FullScreen { get; set; }
    /// <summary>Classes CSS ajoutées au fond assombri.</summary>
    [Parameter] public string? BackdropClass { get; set; }
    /// <summary>Élément qui reçoit le focus à l'ouverture.</summary>
    [Parameter] public UiDefaultFocus DefaultFocus { get; set; } = UiDefaultFocus.FirstChild;
    /// <summary>Appelé après la fermeture de la modale.</summary>
    [Parameter] public EventCallback OnClosed { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_isSetUp)
        {
            _isSetUp = true;
            _dotNetRef = DotNetObjectReference.Create(this);

            try
            {
                if (FocusTrap || CloseOnEscape)
                {
                    await JS.InvokeVoidAsync("UiInterop.setupModal", _backdropRef, _dotNetRef, UiDialogCss.JsOptions(DefaultFocus));
                }
                if (LockScroll)
                {
                    await JS.InvokeVoidAsync("UiInterop.lockBodyScroll");
                }
            }
            catch (JSDisconnectedException) { }
        }
        else if (!IsOpen && _isSetUp)
        {
            await TeardownAsync();
        }
    }

    [JSInvokable]
    public async Task OnEscapePressed()
    {
        if (CloseOnEscape)
        {
            await CloseAsync();
        }
    }

    private async Task HandleBackdropClick()
    {
        if (CloseOnBackdropClick)
        {
            await CloseAsync();
        }
    }

    public async Task CloseAsync()
    {
        IsOpen = false;
        await TeardownAsync();
        await IsOpenChanged.InvokeAsync(false);
        await OnClosed.InvokeAsync();
    }

    private async Task TeardownAsync()
    {
        if (!_isSetUp) return;
        _isSetUp = false;

        try
        {
            await JS.InvokeVoidAsync("UiInterop.teardownModal", _backdropRef);
            if (LockScroll)
            {
                await JS.InvokeVoidAsync("UiInterop.unlockBodyScroll");
            }
        }
        catch (JSDisconnectedException) { }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_isSetUp)
        {
            try
            {
                await JS.InvokeVoidAsync("UiInterop.teardownModal", _backdropRef);
                if (LockScroll)
                {
                    await JS.InvokeVoidAsync("UiInterop.unlockBodyScroll");
                }
            }
            catch { }
        }
        _dotNetRef?.Dispose();
    }
}
