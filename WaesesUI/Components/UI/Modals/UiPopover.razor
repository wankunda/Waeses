@namespace WaesesUI
@inherits UiComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IUiPopoverService PopoverService

<div class="ui-popover @Class" @ref="_rootRef" style="@Style" @attributes="AdditionalAttributes">
    <button type="button"
            class="ui-popover-trigger"
            aria-expanded="@_isOpen"
            aria-haspopup="dialog"
            @onclick="Toggle">
        @Trigger
    </button>
    @if (PopoverService.HasProvider)
    {
        <UiPopoverPanel Open="_isOpen" OpenChanged="HandlePanelOpenChanged" Placement="Placement" Offset="Offset" MatchAnchorWidth="MatchAnchorWidth">
            <div role="dialog" aria-label="@AriaLabel">@ChildContent</div>
        </UiPopoverPanel>
    }
    else if (_isOpen)
    {
        <div class="ui-popover-content" role="dialog" aria-label="@AriaLabel" @onclick:stopPropagation="true">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Position du contenu quand un <see cref="UiPopoverProvider"/> est présent.</summary>
    [Parameter] public UiPopoverPlacement Placement { get; set; } = UiPopoverPlacement.BottomEnd;
    [Parameter] public int Offset { get; set; } = 8;
    [Parameter] public bool MatchAnchorWidth { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    private bool _isOpen;
    private bool _initialized;
    private ElementReference _rootRef;
    private DotNetObjectReference<UiPopover>? _dotNetRef;

    protected override void OnParametersSet()
    {
        if (!_initialized || IsOpenChanged.HasDelegate)
        {
            _isOpen = IsOpen;
            _initialized = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !PopoverService.HasProvider)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("UiInterop.setupOverlay", _rootRef, _dotNetRef);
        }
    }

    [JSInvokable]
    public Task CloseOverlay() => CloseAsync();

    public async Task CloseAsync()
    {
        _isOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task HandlePanelOpenChanged(bool open)
    {
        _isOpen = open;
        await IsOpenChanged.InvokeAsync(open);
    }

    private async Task Toggle()
    {
        _isOpen = !_isOpen;
        await IsOpenChanged.InvokeAsync(_isOpen);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("UiInterop.teardownOverlay", _rootRef);
        }
        catch (JSDisconnectedException) { }
        _dotNetRef?.Dispose();
    }
}
