@namespace WaesesUI
@inherits UiComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="ui-menu @AlignmentClass @(Dense ? "ui-menu-dense" : null) @Class" @ref="_rootRef" style="@Style" @attributes="AdditionalAttributes">
    <button @ref="_triggerRef"
            type="button"
            class="ui-menu-trigger"
            aria-expanded="@(_isOpen ? "true" : "false")"
            aria-haspopup="menu"
            aria-controls="@_menuId"
            disabled="@Disabled"
            @onclick="ToggleAsync">
        @Trigger
    </button>
    @if (_isOpen)
    {
        <div @ref="_menuRef"
             id="@_menuId"
             class="ui-menu-content"
             role="menu"
             aria-label="@AriaLabel"
             popover="manual"
             style="@MenuStyle"
             @onclick="HandleMenuClick">
            @ChildContent
        </div>
    }
</div>

@code {
    /// <summary>Contenu du bouton qui ouvre le menu.</summary>
    [Parameter, EditorRequired] public RenderFragment? Trigger { get; set; }
    /// <summary>Éléments du menu (boutons, liens ou éléments <c>role="menuitem"</c>).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Nom accessible du menu.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Menu d'actions";
    /// <summary>Indique si le menu est ouvert (lié avec <c>bind-IsOpen</c>).</summary>
    [Parameter] public bool IsOpen { get; set; }
    /// <summary>Appelé lorsque le menu s'ouvre ou se ferme.</summary>
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    /// <summary>Désactive le déclencheur.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Réduit l'espacement des éléments.</summary>
    [Parameter] public bool Dense { get; set; }
    /// <summary>Ferme le menu au clic sur un élément.</summary>
    [Parameter] public bool CloseOnItemClick { get; set; } = true;
    /// <summary>Bord du déclencheur sur lequel le menu s'aligne.</summary>
    [Parameter] public UiMenuAlignment Alignment { get; set; } = UiMenuAlignment.End;
    /// <summary>Hauteur maximale CSS du menu, au-delà de laquelle il défile.</summary>
    [Parameter] public string? MaxHeight { get; set; } = "20rem";

    private readonly string _menuId = $"ui-menu-{Guid.NewGuid():N}";
    private bool _isOpen;
    private bool _initialized;
    private bool _keyboardOpening;
    private bool _restoreFocusAfterClose;
    private ElementReference _rootRef;
    private ElementReference _triggerRef;
    private ElementReference _menuRef;
    private DotNetObjectReference<UiMenu>? _dotNetRef;

    private string AlignmentClass => Alignment == UiMenuAlignment.Start
        ? "ui-menu-align-start"
        : "ui-menu-align-end";

    private string? MenuStyle => string.IsNullOrWhiteSpace(MaxHeight)
        ? null
        : $"max-height: {MaxHeight};";

    protected override void OnParametersSet()
    {
        if (!_initialized || IsOpenChanged.HasDelegate)
        {
            _isOpen = IsOpen;
            _initialized = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("UiInterop.setupMenu", _rootRef, _dotNetRef);
        }

        if (_isOpen)
        {
            await JS.InvokeVoidAsync("UiInterop.showMenu", _rootRef, _triggerRef, _menuRef, Alignment == UiMenuAlignment.Start);
        }
        else
        {
            await JS.InvokeVoidAsync("UiInterop.hideMenu", _rootRef);
        }

        if (_keyboardOpening && _isOpen)
        {
            _keyboardOpening = false;
            await JS.InvokeVoidAsync("UiInterop.focusMenuItem", _menuRef, true);
        }

        if (_restoreFocusAfterClose && !_isOpen)
        {
            _restoreFocusAfterClose = false;
            await JS.InvokeVoidAsync("UiInterop.focusElement", _triggerRef);
        }
    }

    [JSInvokable]
    public async Task CloseMenuFromOutside()
    {
        await SetOpenAsync(false);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task CloseMenuFromKeyboard()
    {
        _restoreFocusAfterClose = true;
        await SetOpenAsync(false);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OpenMenuFromKeyboard()
    {
        if (Disabled)
        {
            return;
        }

        if (_isOpen)
        {
            await JS.InvokeVoidAsync("UiInterop.focusMenuItem", _menuRef, true);
            return;
        }

        _keyboardOpening = true;
        await SetOpenAsync(true);
        StateHasChanged();
    }

    private Task ToggleAsync()
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }

        return SetOpenAsync(!_isOpen);
    }

    private async Task HandleMenuClick()
    {
        if (!CloseOnItemClick)
        {
            return;
        }

        _restoreFocusAfterClose = true;
        await SetOpenAsync(false);
    }

    private async Task SetOpenAsync(bool value)
    {
        if (_isOpen == value)
        {
            return;
        }

        _isOpen = value;
        await IsOpenChanged.InvokeAsync(value);
    }

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef is null)
        {
            return;
        }

        await JS.TryTeardownAsync("UiInterop.teardownMenu", _rootRef);

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
