@namespace WaesesUI
@inherits UiComponentBase

<div class="ui-chart @Class" style="@Style" @attributes="AdditionalAttributes">
    <svg class="ui-chart-svg" viewBox="0 0 @Width @Height" role="img" aria-label="@AriaLabel" preserveAspectRatio="none">
        @if (ShowGrid)
        {
            @foreach (var tick in GridTicks)
            {
                var y = ChartTop + (ChartHeight * (1 - tick / Maximum));
                <line x1="@ChartLeft.ToString("0.##", CultureInfo.InvariantCulture)" y1="@y.ToString("0.##", CultureInfo.InvariantCulture)" x2="@((Width - ChartRight).ToString("0.##", CultureInfo.InvariantCulture))" y2="@y.ToString("0.##", CultureInfo.InvariantCulture)" class="ui-chart-grid-line" />
                @((MarkupString)SvgText(ChartLeft - 8, y + 4, "end", "ui-chart-axis-label", FormatValue(tick)))
            }
        }

        @for (var index = 0; index < Data.Count; index++)
        {
            var item = Data[index];
            var barWidth = ChartWidth / Math.Max(Data.Count, 1) * 0.64;
            var x = ChartLeft + (ChartWidth / Math.Max(Data.Count, 1) * index) + ((ChartWidth / Math.Max(Data.Count, 1) - barWidth) / 2);
            var barHeight = ChartHeight * Math.Max(item.Value, 0) / Maximum;
            var y = ChartTop + ChartHeight - barHeight;
            <rect x="@x.ToString("0.##", CultureInfo.InvariantCulture)" y="@y.ToString("0.##", CultureInfo.InvariantCulture)" width="@barWidth.ToString("0.##", CultureInfo.InvariantCulture)" height="@barHeight.ToString("0.##", CultureInfo.InvariantCulture)" rx="4" style="fill: @(item.Color ?? GetPaletteColor(index));" class="ui-chart-bar">
                <title>@item.Label : @FormatValue(item.Value)</title>
            </rect>
            @if (ShowValues)
            {
                @((MarkupString)SvgText(x + barWidth / 2, y - 8, "middle", "ui-chart-value-label", FormatValue(item.Value)))
            }
            @((MarkupString)SvgText(x + barWidth / 2, Height - 14, "middle", "ui-chart-axis-label", item.Label))
        }
    </svg>
</div>

@code {
    [Parameter] public IReadOnlyList<UiChartData> Data { get; set; } = Array.Empty<UiChartData>();
    [Parameter] public int Width { get; set; } = 640;
    [Parameter] public int Height { get; set; } = 320;
    [Parameter] public bool ShowGrid { get; set; } = true;
    [Parameter] public bool ShowValues { get; set; } = true;
    [Parameter] public string AriaLabel { get; set; } = "Graphique en barres";
    /// <summary>
    /// Format .NET des valeurs (axe, étiquettes, info-bulles), par exemple <c>"N0"</c> pour « 50 000 » selon la culture.
    /// Null : <c>"0.##"</c> en culture invariante (comportement historique).
    /// </summary>
    [Parameter] public string? ValueFormat { get; set; }

    /// <summary>Met en forme une valeur à la place de <see cref="ValueFormat"/> (devise, unité, abréviation...).</summary>
    [Parameter] public Func<double, string>? ValueFormatter { get; set; }


    // La marge gauche s'adapte à la largeur des étiquettes de l'axe (« 1 000 000 » ne doit pas être coupé)
    private double ChartLeft => Math.Max(48, FormatValue(Maximum).Length * 7.5 + 14);
    private const double ChartRight = 16;
    private const double ChartTop = 24;
    private const double ChartBottom = 38;
    private double ChartWidth => Math.Max(Width - ChartLeft - ChartRight, 1);
    private double ChartHeight => Math.Max(Height - ChartTop - ChartBottom, 1);
    private double Maximum => Math.Max(Data.Count == 0 ? 0 : Data.Max(item => item.Value), 1);
    private IEnumerable<double> GridTicks => Enumerable.Range(0, 5).Select(index => Maximum * index / 4);

    private static string GetPaletteColor(int index) => (index % 4) switch
    {
        0 => "var(--primary)",
        1 => "var(--info)",
        2 => "var(--success)",
        _ => "var(--warning)"
    };

    private static string SvgText(double x, double y, string anchor, string cssClass, string value) =>
        $"<text x=\"{x.ToString("0.##", CultureInfo.InvariantCulture)}\" y=\"{y.ToString("0.##", CultureInfo.InvariantCulture)}\" text-anchor=\"{anchor}\" class=\"{cssClass}\">{System.Net.WebUtility.HtmlEncode(value)}</text>";

    private string FormatValue(double value) =>
        ValueFormatter is not null ? ValueFormatter(value)
        : ValueFormat is not null ? value.ToString(ValueFormat, CultureInfo.CurrentCulture)
        : value.ToString("0.##", CultureInfo.InvariantCulture);
}