@namespace WaesesUI
@inherits UiComponentBase

<UiFormField For="@Id" Label="@Label" HelperText="@HelperText" Error="@ErrorMessage" Required="@Required" Class="@($"{FieldClass} {Class}")">
    <div class="ui-tag-input" @onclick="FocusInput">
        @foreach (var tag in Values)
        {
            <UiChip Text="@tag" Dismissible="true" OnDismiss="() => RemoveAsync(tag)" />
        }
        <input @ref="_inputRef" id="@Id" value="@_draft" placeholder="@Placeholder" disabled="@Disabled" aria-label="@Label" aria-invalid="@(string.IsNullOrEmpty(ErrorMessage) ? null : "true")" aria-describedby="@DescribedBy" @oninput="UpdateDraft" @onkeydown="HandleKeyDown" @onblur="HandleBlur" style="@Style" @attributes="AdditionalAttributes" />
    </div>
</UiFormField>

@code {
    private ElementReference _inputRef;
    private string? DescribedBy => !string.IsNullOrEmpty(ErrorMessage) ? $"{Id}-error" : (!string.IsNullOrEmpty(HelperText) ? $"{Id}-helper" : null);
    private string _draft = string.Empty;

    /// <summary>Apparence du champ : contour (défaut), fond teinté ou soulignement seul.</summary>
    [Parameter] public UiVariant? Variant { get; set; }

    /// <summary>Couleur de mise en avant (focus).</summary>
    [Parameter] public UiColor? Color { get; set; }

    private string FieldClass => UiStyle.FieldClasses(Variant, Color);

    /// <summary>Identifiant de l'élément ; généré automatiquement si absent.</summary>
    [Parameter] public string? Id { get; set; } = $"tags-{Guid.NewGuid():N}";
    /// <summary>Libellé affiché au-dessus du champ.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Texte indicatif affiché tant que le champ est vide.</summary>
    [Parameter] public string? Placeholder { get; set; } = "Ajouter une valeur...";
    /// <summary>Texte d'aide sous le champ.</summary>
    [Parameter] public string? HelperText { get; set; }
    /// <summary>Message d'erreur affiché sous le champ.</summary>
    [Parameter] public string? ErrorMessage { get; set; }
    /// <summary>Marque le champ comme obligatoire.</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Désactive le champ.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Étiquettes saisies (lié avec <c>bind-Values</c>).</summary>
    [Parameter] public IReadOnlyList<string> Values { get; set; } = Array.Empty<string>();
    /// <summary>Appelé quand une étiquette est ajoutée ou retirée.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> ValuesChanged { get; set; }
    /// <summary>Caractère qui valide une étiquette (en plus d'Entrée et de Tab).</summary>
    [Parameter] public char Separator { get; set; } = ',';
    /// <summary>Nombre maximal d'étiquettes. 0 : illimité.</summary>
    [Parameter] public int MaxTags { get; set; } = 0;

    private void UpdateDraft(ChangeEventArgs args) => _draft = args.Value?.ToString() ?? string.Empty;

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "Tab" || args.Key.Length == 1 && args.Key[0] == Separator)
        {
            await CommitAsync();
        }
        else if (args.Key == "Backspace" && string.IsNullOrEmpty(_draft) && Values.Count > 0)
        {
            await RemoveAsync(Values[^1]);
        }
    }

    private Task HandleBlur(FocusEventArgs _) => CommitAsync();

    private async Task CommitAsync()
    {
        var newTags = _draft.Split(Separator, StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (newTags.Length == 0) return;
        var values = Values.ToList();
        foreach (var tag in newTags.Distinct(StringComparer.OrdinalIgnoreCase))
        {
            if (!values.Contains(tag, StringComparer.OrdinalIgnoreCase) && (MaxTags <= 0 || values.Count < MaxTags)) values.Add(tag);
        }
        _draft = string.Empty;
        await ValuesChanged.InvokeAsync(values);
    }

    private Task RemoveAsync(string tag) => ValuesChanged.InvokeAsync(Values.Where(value => !string.Equals(value, tag, StringComparison.OrdinalIgnoreCase)).ToArray());

    private async Task FocusInput() => await _inputRef.FocusAsync();
}
