@typeparam TValue
@inherits UiInputBase<TValue>
@namespace WaesesUI

<UiFormField For="@Id" Label="@Label" HelperText="@HelperText" Error="@GetFirstError()" Required="@Required" Class="@Class" Style="@Style">
    <div class="ui-color-picker">
        <input id="@Id" aria-invalid="@AriaInvalid" aria-describedby="@DescribedBy" type="color" class="ui-color-swatch" value="@ColorValue" disabled="@Disabled" @oninput="HandleInput" @attributes="AdditionalAttributes" />
        <input type="text" class="ui-input" value="@ColorValue" aria-label="Valeur hexadécimale" maxlength="9" disabled="@Disabled" @onchange="HandleInput" />
    </div>
</UiFormField>

@code {
    protected override string IdPrefix => "color";

    private string ColorValue => CurrentValueAsString is { Length: 7 } value && value.StartsWith('#') ? value : "#000000";

    private void HandleInput(ChangeEventArgs args)
    {
        var color = args.Value?.ToString();
        if (color is { Length: 7 } && color[0] == '#' && color[1..].All(Uri.IsHexDigit)) CurrentValueAsString = color;
    }

    protected override bool TryParseValueFromString(string? value, out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (BindConverter.TryConvertTo<TValue>(value, CultureInfo.CurrentCulture, out var parsed))
        {
            result = parsed!;
            validationErrorMessage = null;
            return true;
        }
        result = default!;
        validationErrorMessage = "La couleur n'est pas valide.";
        return false;
    }
}
