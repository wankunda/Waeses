@inherits UiInputBase<double>
@namespace WaesesUI

<div class="ui-slider-container @CssClass @ColorClass @Class" style="@Style">
    <div class="ui-slider-header">
        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="ui-label" for="@Id">@Label</label>
        }
        @if (ShowValue)
        {
            <span class="ui-slider-val">@CurrentValue@Unit</span>
        }
    </div>

    <input id="@Id"
           type="range"
           class="ui-slider"
           min="@Min"
           max="@Max"
           step="@Step"
           value="@CurrentValue"
           disabled="@Disabled"
           @oninput="HandleInput"
           @attributes="AdditionalAttributes" />

    @if (HasError)
    {
        <div class="ui-error-text">
            <span>⚠</span>
            <span>@GetFirstError()</span>
        </div>
    }
</div>

@code {
    protected override string IdPrefix => "slider";

    /// <summary>Valeur minimale.</summary>
    [Parameter] public double Min { get; set; } = 0;
    /// <summary>Valeur maximale.</summary>
    [Parameter] public double Max { get; set; } = 100;
    /// <summary>Pas de variation.</summary>
    [Parameter] public double Step { get; set; } = 1;
    /// <summary>Affiche la valeur courante à côté du libellé.</summary>
    [Parameter] public bool ShowValue { get; set; } = true;
    /// <summary>Unité affichée après la valeur (par exemple <c>%</c> ou <c> px</c>).</summary>
    [Parameter] public string? Unit { get; set; }

    protected override bool TryParseValueFromString(string? value, out double result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (double.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out result))
        {
            validationErrorMessage = null;
            return true;
        }
        result = default;
        validationErrorMessage = "La valeur doit être un nombre valide.";
        return false;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var val))
        {
            CurrentValue = val;
        }
    }
}
