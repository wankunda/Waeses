@inherits InputBase<double>
@namespace WaesesUI

<div class="ui-slider-container @CssClass @Class">
    <div class="ui-slider-header">
        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="ui-label" for="@Id">@Label</label>
        }
        @if (ShowValue)
        {
            <span class="ui-slider-val">@CurrentValue@Unit</span>
        }
    </div>

    <input id="@Id"
           type="range"
           class="ui-slider"
           min="@Min"
           max="@Max"
           step="@Step"
           value="@CurrentValue"
           disabled="@Disabled"
           @oninput="HandleInput"
           @attributes="AdditionalAttributes" />

    @if (HasError)
    {
        <div class="ui-error-text">
            <span>⚠</span>
            <span>@GetFirstError()</span>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; } = $"slider-{Guid.NewGuid():N}";
    [Parameter] public string? Label { get; set; }
    [Parameter] public double Min { get; set; } = 0;
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public bool ShowValue { get; set; } = true;
    [Parameter] public string? Unit { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? Class { get; set; }

    private IEnumerable<string> GetErrors()
    {
        if (!string.IsNullOrEmpty(ErrorMessage))
        {
            yield return ErrorMessage;
        }

        if (EditContext != null && ValueExpression != null)
        {
            foreach (var msg in EditContext.GetValidationMessages(FieldIdentifier))
            {
                yield return msg;
            }
        }
    }

    private bool HasError => GetErrors().Any();
    private string GetFirstError() => GetErrors().FirstOrDefault() ?? string.Empty;

    protected override bool TryParseValueFromString(string? value, out double result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (double.TryParse(value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out result))
        {
            validationErrorMessage = null;
            return true;
        }
        result = default;
        validationErrorMessage = "La valeur doit être un nombre valide.";
        return false;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var val))
        {
            CurrentValue = val;
        }
    }
}
