@typeparam TValue
@inherits UiInputBase<TValue>
@namespace WaesesUI

<div class="ui-form-group @FieldClass @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="ui-label" for="@Id">
            @Label
            @if (Required || IsRequiredByAttribute())
            {
                <span class="ui-label-required">*</span>
            }
        </label>
    }
    <textarea id="@Id"
              aria-invalid="@AriaInvalid" aria-describedby="@DescribedBy" aria-required="@(IsRequired ? "true" : null)"
              class="ui-input ui-textarea @CssClass @(HasError ? "ui-input-error" : "")"
              placeholder="@Placeholder"
              rows="@Rows"
              disabled="@Disabled"
              readonly="@ReadOnly"
              maxlength="@MaxLength"
              @oninput="HandleInput"
              @onchange="HandleChange"
              @attributes="AdditionalAttributes">@CurrentValueAsString</textarea>
    @if (ShowCharacterCount && MaxLength.HasValue)
    {
        <div class="ui-textarea-count">@((CurrentValueAsString ?? string.Empty).Length) / @MaxLength</div>
    }
    <UiInputMessages Error="@(HasError ? GetFirstError() : null)" HelperText="@HelperText" ErrorId="@ErrorId" HelperId="@HelperId" />
</div>

@code {
    protected override string IdPrefix => "textarea";

    /// <summary>Texte indicatif affiché tant que le champ est vide.</summary>
    [Parameter] public string? Placeholder { get; set; }
    /// <summary>Nombre de lignes visibles.</summary>
    [Parameter] public int Rows { get; set; } = 4;
    /// <summary>Nombre maximal de caractères saisissables.</summary>
    [Parameter] public int? MaxLength { get; set; }
    /// <summary>Affiche le compteur de caractères (nécessite <c>MaxLength</c>).</summary>
    [Parameter] public bool ShowCharacterCount { get; set; }

    private Task HandleInput(ChangeEventArgs args) => HandleTextEventAsync(args.Value?.ToString(), isInput: true);
    private Task HandleChange(ChangeEventArgs args) => HandleTextEventAsync(args.Value?.ToString(), isInput: false);

    protected override bool TryParseValueFromString(string? value, out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (BindConverter.TryConvertTo<TValue>(value, CultureInfo.CurrentCulture, out var parsedValue))
        {
            result = parsedValue!;
            validationErrorMessage = null;
            return true;
        }

        result = default!;
        validationErrorMessage = $"La valeur « {value} » n'est pas valide.";
        return false;
    }

}
