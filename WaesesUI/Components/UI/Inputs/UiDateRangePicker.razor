@namespace WaesesUI
@inherits UiComponentBase

<UiFormField For="@Id" Label="@Label" HelperText="@HelperText" Error="@CurrentError" Required="@Required" Class="@($"{FieldClass} {Class}")">
    <div class="ui-date-range">
        <input id="@Id" type="date" class="ui-input" value="@Format(Range.Start)" min="@Min" max="@Range.End?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" disabled="@Disabled" aria-label="Date de début" aria-invalid="@(CurrentError != null ? "true" : null)" aria-describedby="@DescribedBy" @onchange="SetStart" style="@Style" @attributes="AdditionalAttributes" />
        <span aria-hidden="true">–</span>
        <input type="date" class="ui-input" value="@Format(Range.End)" min="@Range.Start?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" max="@Max" disabled="@Disabled" aria-label="Date de fin" @onchange="SetEnd" />
    </div>
</UiFormField>

@code {
    /// <summary>Apparence du champ : contour (défaut), fond teinté ou soulignement seul.</summary>
    [Parameter] public UiVariant? Variant { get; set; }

    /// <summary>Couleur de mise en avant (focus).</summary>
    [Parameter] public UiColor? Color { get; set; }

    private string FieldClass => UiStyle.FieldClasses(Variant, Color);

    /// <summary>Identifiant du champ de début ; généré automatiquement si absent.</summary>
    [Parameter] public string? Id { get; set; } = $"date-range-{Guid.NewGuid():N}";
    /// <summary>Libellé affiché au-dessus des deux champs.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Texte d'aide sous les champs.</summary>
    [Parameter] public string? HelperText { get; set; }
    /// <summary>Marque le champ comme obligatoire.</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Désactive les deux champs.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Date de début (lié avec <c>bind-Start</c>).</summary>
    [Parameter] public DateTime? Start { get; set; }
    /// <summary>Appelé quand la date de début change.</summary>
    [Parameter] public EventCallback<DateTime?> StartChanged { get; set; }
    /// <summary>Date de fin (lié avec <c>bind-End</c>).</summary>
    [Parameter] public DateTime? End { get; set; }
    /// <summary>Appelé quand la date de fin change.</summary>
    [Parameter] public EventCallback<DateTime?> EndChanged { get; set; }
    /// <summary>Date minimale sélectionnable, au format <c>yyyy-MM-dd</c>.</summary>
    [Parameter] public string? Min { get; set; }
    /// <summary>Date maximale sélectionnable, au format <c>yyyy-MM-dd</c>.</summary>
    [Parameter] public string? Max { get; set; }

    private string? DescribedBy => CurrentError != null ? $"{Id}-error" : (!string.IsNullOrEmpty(HelperText) ? $"{Id}-helper" : null);
    private UiDateRange Range => new(Start, End);
    private string? CurrentError => Start.HasValue && End.HasValue && Start > End ? "La date de début doit précéder la date de fin." : null;
    private static string Format(DateTime? value) => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;

    private async Task SetStart(ChangeEventArgs args)
    {
        await StartChanged.InvokeAsync(Parse(args.Value?.ToString()));
    }

    private async Task SetEnd(ChangeEventArgs args)
    {
        await EndChanged.InvokeAsync(Parse(args.Value?.ToString()));
    }

    private static DateTime? Parse(string? value) => DateTime.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;
}
