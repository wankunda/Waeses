@namespace WaesesUI
@inherits UiComponentBase

<div class="ui-form-group @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="ui-label" for="@For">@Label @if (Required) { <span class="ui-label-required">*</span> }</label>
    }
    @ChildContent
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div id="@ErrorId" class="ui-error-text" role="alert">@Error</div>
    }
    else if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div class="ui-helper-text" id="@HelperId">@HelperText</div>
    }
</div>

@code {
    /// <summary>Identifiant du contrôle étiqueté (attribut <c>for</c> du libellé).</summary>
    [Parameter] public string? For { get; set; }
    /// <summary>Libellé du champ.</summary>
    [Parameter] public string? Label { get; set; }
    /// <summary>Texte d'aide sous le champ.</summary>
    [Parameter] public string? HelperText { get; set; }
    /// <summary>Message d'erreur ; remplace le texte d'aide.</summary>
    [Parameter] public string? Error { get; set; }
    /// <summary>Affiche l'astérisque d'un champ obligatoire.</summary>
    [Parameter] public bool Required { get; set; }
    /// <summary>Le contrôle de saisie à habiller.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string HelperId => $"{For ?? "field"}-helper";
    private string ErrorId => $"{For ?? "field"}-error";
}
