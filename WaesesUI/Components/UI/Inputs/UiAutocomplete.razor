@namespace WaesesUI
@typeparam TItem
@typeparam TValue
@inherits InputBase<TValue>
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="ui-form-group ui-autocomplete @Class" style="@Style" @ref="_rootRef">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="ui-label" for="@Id">
            @Label
            @if (Required || IsRequiredByAttribute())
            {
                <span class="ui-label-required">*</span>
            }
        </label>
    }

    <div class="ui-input-wrapper ui-autocomplete-wrapper">
        @if (!string.IsNullOrEmpty(PrefixIcon))
        {
            <span class="ui-input-prefix">
                @if (PrefixIcon.TrimStart().StartsWith("<"))
                {
                    <UiIcon Icon="@PrefixIcon" Size="UiSize.Sm" />
                }
                else
                {
                    @PrefixIcon
                }
            </span>
        }

        <input id="@Id"
               type="text"
               class="ui-input @CssClass @(HasError ? "ui-input-error" : "") @(!string.IsNullOrEmpty(PrefixIcon) ? "ui-input-has-prefix" : "") ui-input-has-suffix"
               placeholder="@Placeholder"
               value="@_searchText"
               disabled="@Disabled"
               readonly="@ReadOnly"
               autocomplete="off"
               role="combobox"
               aria-expanded="@_isOpen"
               aria-haspopup="listbox"
               aria-autocomplete="list"
               aria-busy="@_isLoading"
               aria-activedescendant="@(_highlightedIndex >= 0 ? $"autocomplete-opt-{Id}-{_highlightedIndex}" : null)"
               @onfocus="HandleFocus"
               @oninput="HandleSearchInput"
               @onkeydown="HandleKeyDown"
               @attributes="AdditionalAttributes" />

        <div class="ui-input-actions ui-autocomplete-actions">
            @if (Clearable && CurrentValue != null && !EqualityComparer<TValue>.Default.Equals(CurrentValue, default!))
            {
                <button type="button"
                        class="ui-input-btn"
                        style="background: transparent; border: none; cursor: pointer; color: var(--text-muted); font-size: 0.85rem; padding: 0.2rem; display: flex; align-items: center;"
                        @onclick="ClearSelection"
                        @onclick:stopPropagation="true"
                        tabindex="-1"
                        title="Effacer la sélection">
                    ✕
                </button>
            }
            @if (_isLoading)
            {
                <span class="ui-autocomplete-loading" aria-hidden="true"></span>
            }
            else
            {
                <span class="ui-autocomplete-chevron @( _isOpen ? "ui-autocomplete-chevron-open" : "")" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
                </span>
            }
        </div>
    </div>

    @if (_isOpen && _isLoading)
    {
        <div class="ui-autocomplete-dropdown" role="status">
            <div class="ui-autocomplete-empty">@(LoadingText ?? "Recherche en cours...")</div>
        </div>
    }
    else if (_isOpen && _filteredItems.Any())
    {
        <div class="ui-autocomplete-dropdown" role="listbox" aria-label="@(Label ?? "Options")">
            @{ var idx = 0; }
            @foreach (var item in _filteredItems)
            {
                var capturedIdx = idx;
                var capturedItem = item;
                var isHighlighted = capturedIdx == _highlightedIndex;
                var isSelected = EqualityComparer<TValue>.Default.Equals(ValueSelector(capturedItem), CurrentValue);

                <div id="autocomplete-opt-@(Id)-@capturedIdx"
                     class="ui-autocomplete-option @(isHighlighted ? "ui-autocomplete-highlighted" : "") @(isSelected ? "ui-autocomplete-selected" : "")"
                     role="option"
                     aria-selected="@isSelected"
                     @onclick="() => SelectItem(capturedItem)"
                     @onmouseenter="() => _highlightedIndex = capturedIdx">
                    @if (ItemTemplate != null)
                    {
                        @ItemTemplate(capturedItem)
                    }
                    else
                    {
                        <span>@DisplaySelector(capturedItem)</span>
                    }
                    @if (isSelected)
                    {
                        <svg class="ui-autocomplete-check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    }
                </div>
                idx++;
            }
        </div>
    }
    else if (_isOpen && !_filteredItems.Any())
    {
        <div class="ui-autocomplete-dropdown" role="listbox">
            <div class="ui-autocomplete-empty">
                @(EmptyText ?? "Aucun résultat trouvé")
            </div>
        </div>
    }

    @if (HasError)
    {
        <div class="ui-error-text">
            <span>⚠</span>
            <span>@GetFirstError()</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="ui-helper-text">
            @HelperText
        </div>
    }
</div>

@code {
    private ElementReference _rootRef;
    private bool _isOpen;
    private string _searchText = string.Empty;
    private int _highlightedIndex = -1;
    private List<TItem> _filteredItems = new();
    private bool _suppressSearch;
    private bool _isLoading;
    private CancellationTokenSource? _searchCts;
    private DotNetObjectReference<UiAutocomplete<TItem, TValue>>? _dotNetRef;

    [Parameter] public string? Id { get; set; } = $"autocomplete-{Guid.NewGuid():N}";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? PrefixIcon { get; set; }
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public string? LoadingText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    /// <summary>All available items to search from.</summary>
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();

    /// <summary>Extracts the display text from an item.</summary>
    [Parameter, EditorRequired] public Func<TItem, string> DisplaySelector { get; set; } = default!;

    /// <summary>Extracts the bound value from an item.</summary>
    [Parameter, EditorRequired] public Func<TItem, TValue> ValueSelector { get; set; } = default!;

    /// <summary>Custom filter predicate. Defaults to case-insensitive contains on display text.</summary>
    [Parameter] public Func<TItem, string, bool>? FilterPredicate { get; set; }

    /// <summary>Optional custom template for each dropdown option.</summary>
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>Maximum number of items shown in the dropdown.</summary>
    [Parameter] public int MaxResults { get; set; } = 50;
    [Parameter] public int DebounceDelay { get; set; } = 250;
    [Parameter] public bool OpenOnFocus { get; set; } = true;

    /// <summary>Optional asynchronous search provider. When set, it takes precedence over Items.</summary>
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<TItem>>>? SearchFunc { get; set; }

    protected override void OnParametersSet()
    {
        // Sync the search text with the current value on external changes
        if (!_isOpen && !_suppressSearch)
        {
            var selected = Items.FirstOrDefault(i => EqualityComparer<TValue>.Default.Equals(ValueSelector(i), CurrentValue));
            if (selected != null)
            {
                _searchText = DisplaySelector(selected);
            }
            else if (CurrentValue == null || EqualityComparer<TValue>.Default.Equals(CurrentValue, default!))
            {
                _searchText = string.Empty;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("UiInterop.setupAutocomplete", _rootRef, _dotNetRef);
        }
    }

    private async Task HandleFocus()
    {
        if (Disabled || ReadOnly || !OpenOnFocus) return;
        _isOpen = true;
        _highlightedIndex = -1;
        await ApplyFilterAsync();
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;
        _isOpen = true;
        _highlightedIndex = 0;
        await ApplyFilterAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                if (!_isOpen) { _isOpen = true; await ApplyFilterAsync(); }
                _highlightedIndex = Math.Min(_highlightedIndex + 1, _filteredItems.Count - 1);
                break;

            case "ArrowUp":
                _highlightedIndex = Math.Max(_highlightedIndex - 1, 0);
                break;

            case "Enter":
                if (_isOpen && _highlightedIndex >= 0 && _highlightedIndex < _filteredItems.Count)
                {
                    SelectItem(_filteredItems[_highlightedIndex]);
                }
                break;

            case "Escape":
                CloseDropdown();
                break;

            case "Tab":
                if (_isOpen && _highlightedIndex >= 0 && _highlightedIndex < _filteredItems.Count)
                {
                    SelectItem(_filteredItems[_highlightedIndex]);
                }
                else
                {
                    CloseDropdown();
                }
                break;
        }
    }

    private void SelectItem(TItem item)
    {
        _suppressSearch = true;
        CurrentValue = ValueSelector(item);
        _searchText = DisplaySelector(item);
        _isOpen = false;
        _highlightedIndex = -1;
        _suppressSearch = false;
    }

    private void ClearSelection()
    {
        _suppressSearch = true;
        CurrentValue = default!;
        _searchText = string.Empty;
        _isOpen = false;
        _highlightedIndex = -1;
        _suppressSearch = false;
    }

    private void CloseDropdown()
    {
        _isOpen = false;
        _highlightedIndex = -1;

        // Restore display text for current value
        var selected = Items.FirstOrDefault(i => EqualityComparer<TValue>.Default.Equals(ValueSelector(i), CurrentValue));
        if (selected != null)
        {
            _searchText = DisplaySelector(selected);
        }
        else
        {
            _searchText = string.Empty;
        }
    }

    [JSInvokable]
    public Task CloseAutocompleteAsync()
    {
        CloseDropdown();
        return InvokeAsync(StateHasChanged);
    }

    private async Task ApplyFilterAsync()
    {
        var query = _searchText?.Trim() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var cancellationToken = _searchCts.Token;

        if (DebounceDelay > 0)
        {
            try
            {
                await Task.Delay(DebounceDelay, cancellationToken);
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }

        if (SearchFunc != null)
        {
            _isLoading = true;
            try
            {
                _filteredItems = (await SearchFunc(query, cancellationToken)).Take(Math.Max(1, MaxResults)).ToList();
            }
            catch (OperationCanceledException)
            {
                return;
            }
            finally
            {
                _isLoading = false;
            }

            return;
        }

        var predicate = FilterPredicate ?? DefaultFilter;

        _filteredItems = (string.IsNullOrEmpty(query)
                ? Items
                : Items.Where(i => predicate(i, query)))
            .Take(Math.Max(1, MaxResults))
            .ToList();
    }

    public async ValueTask DisposeAsync()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        if (_dotNetRef != null)
        {
            await JS.InvokeVoidAsync("UiInterop.teardownAutocomplete", _rootRef);
            _dotNetRef.Dispose();
        }
    }

    private bool DefaultFilter(TItem item, string query)
    {
        return DisplaySelector(item).Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    // ─── Validation helpers ──────────────────────────────────

    private IEnumerable<string> GetErrors()
    {
        if (!string.IsNullOrEmpty(ErrorMessage))
        {
            yield return ErrorMessage;
        }

        if (EditContext != null && ValueExpression != null)
        {
            foreach (var msg in EditContext.GetValidationMessages(FieldIdentifier))
            {
                yield return msg;
            }
        }
    }

    private bool HasError => GetErrors().Any();
    private string GetFirstError() => GetErrors().FirstOrDefault() ?? string.Empty;

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        try
        {
            if (typeof(TValue) == typeof(string))
            {
                result = (TValue)(object)(value ?? string.Empty);
                validationErrorMessage = null;
                return true;
            }

            if (string.IsNullOrEmpty(value))
            {
                result = default!;
                validationErrorMessage = null;
                return true;
            }

            var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            if (targetType.IsEnum)
            {
                result = (TValue)Enum.Parse(targetType, value);
                validationErrorMessage = null;
                return true;
            }

            result = (TValue)Convert.ChangeType(value, targetType, System.Globalization.CultureInfo.InvariantCulture);
            validationErrorMessage = null;
            return true;
        }
        catch (Exception ex)
        {
            result = default!;
            validationErrorMessage = $"Valeur invalide : {ex.Message}";
            return false;
        }
    }

    private bool IsRequiredByAttribute()
    {
        if (EditContext != null && ValueExpression != null)
        {
            var memberExpression = ValueExpression.Body as System.Linq.Expressions.MemberExpression;
            if (memberExpression != null)
            {
                var property = memberExpression.Member;
                return property.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.RequiredAttribute), true).Any();
            }
        }
        return false;
    }
}
