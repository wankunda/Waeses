@typeparam TValue
@inherits UiInputBase<TValue>
@namespace WaesesUI

<div class="ui-form-group @FieldClass @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="ui-label" for="@Id">
            @Label
            @if (Required || IsRequiredByAttribute())
            {
                <span class="ui-label-required">*</span>
            }
        </label>
    }

    <div class="ui-input-wrapper">
        <select id="@Id"
                aria-invalid="@AriaInvalid" aria-describedby="@DescribedBy" aria-required="@(IsRequired ? "true" : null)"
                class="ui-select @CssClass @(HasError ? "ui-input-error" : "")"
                value="@CurrentValueAsString"
                disabled="@Disabled"
                @onchange="HandleChange"
                @attributes="AdditionalAttributes">
            @if (!string.IsNullOrEmpty(Placeholder))
            {
                <option value="" disabled selected="@(Value == null)">@Placeholder</option>
            }
            @if (Items != null)
            {
                @foreach (var item in Items)
                {
                    <option value="@FormatOption(item)" disabled="@(ItemDisabled?.Invoke(item) == true)">@ItemTextOf(item)</option>
                }
            }
            @if (ChildContent != null)
            {
                <CascadingValue Value="this" IsFixed="true">
                    @ChildContent
                </CascadingValue>
            }
        </select>
    </div>

    <UiInputMessages Error="@(HasError ? GetFirstError() : null)" HelperText="@HelperText" ErrorId="@ErrorId" HelperId="@HelperId" />
</div>

@code {
    protected override string IdPrefix => "select";

    /// <summary>Options : des <see cref="UiSelectOption{TValue}"/> ou des éléments <c>&lt;option&gt;</c> natifs.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Libellé de l'option vide, désactivée, affichée en premier tant qu'aucune valeur n'est choisie.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>
    /// Valeurs proposées : une option est générée par élément (avant celles de <see cref="ChildContent"/>).
    /// Pour une énumération : <c>Items="Enum.GetValues&lt;Level&gt;()"</c>.
    /// </summary>
    [Parameter] public IEnumerable<TValue>? Items { get; set; }

    /// <summary>
    /// Libellé d'un élément de <see cref="Items"/>. Par défaut : l'attribut <c>[Description]</c> d'une énumération, sinon <c>ToString()</c>.
    /// Reçoit <c>default</c> pour un élément <c>null</c> (types nullables).
    /// </summary>
    [Parameter] public Func<TValue, string>? ItemText { get; set; }

    /// <summary>Indique les éléments visibles mais non sélectionnables.</summary>
    [Parameter] public Func<TValue, bool>? ItemDisabled { get; set; }

    // Format invariant, symétrique de TryParseValueFromString : « 1,5 » en culture française ne se relirait pas.
    protected override string? FormatValueAsString(TValue? value) => value switch
    {
        null => string.Empty,
        IFormattable formattable => formattable.ToString(null, System.Globalization.CultureInfo.InvariantCulture),
        _ => value.ToString()
    };

    private string ItemTextOf(TValue? item)
    {
        if (ItemText != null) return ItemText(item!);

        return item switch
        {
            null => string.Empty,
            Enum value when value.GetType().GetField(value.ToString()) is not null => value.ToDescription(),
            _ => item.ToString() ?? string.Empty
        };
    }

    /// <summary>Valeur texte d'une option (celle que lira <see cref="UiSelect{TValue}"/> au changement).</summary>
    internal string FormatOption(TValue? value) => FormatValueAsString(value) ?? string.Empty;

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        try
        {
            if (typeof(TValue) == typeof(string))
            {
                result = (TValue)(object)(value ?? string.Empty);
                validationErrorMessage = null;
                return true;
            }

            if (string.IsNullOrEmpty(value))
            {
                result = default!;
                validationErrorMessage = null;
                return true;
            }

            var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            if (targetType.IsEnum)
            {
                result = (TValue)Enum.Parse(targetType, value);
                validationErrorMessage = null;
                return true;
            }

            // Guid, DateOnly, TimeOnly... ne sont pas IConvertible : Convert.ChangeType les refuse, TypeConverter les gère
            var converted = typeof(IConvertible).IsAssignableFrom(targetType)
                ? Convert.ChangeType(value, targetType, System.Globalization.CultureInfo.InvariantCulture)
                : System.ComponentModel.TypeDescriptor.GetConverter(targetType).ConvertFromInvariantString(value);

            result = (TValue)converted!;
            validationErrorMessage = null;
            return true;
        }
        catch (Exception ex)
        {
            result = default!;
            validationErrorMessage = $"Valeur invalide : {ex.Message}";
            return false;
        }
    }

    private void HandleChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

}
