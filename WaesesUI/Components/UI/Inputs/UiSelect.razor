@typeparam TValue
@inherits InputBase<TValue>
@namespace WaesesUI

<div class="ui-form-group @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="ui-label" for="@Id">
            @Label
            @if (Required || IsRequiredByAttribute())
            {
                <span class="ui-label-required">*</span>
            }
        </label>
    }

    <div class="ui-input-wrapper">
        <select id="@Id"
                class="ui-select @CssClass @(HasError ? "ui-input-error" : "")"
                value="@CurrentValueAsString"
                disabled="@Disabled"
                @onchange="HandleChange"
                @attributes="AdditionalAttributes">
            @if (!string.IsNullOrEmpty(Placeholder))
            {
                <option value="" disabled selected="@(Value == null)">@Placeholder</option>
            }
            @if (ChildContent != null)
            {
                @ChildContent
            }
        </select>
    </div>

    @if (HasError)
    {
        <div class="ui-error-text">
            <span>⚠</span>
            <span>@GetFirstError()</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="ui-helper-text">
            @HelperText
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; } = $"select-{Guid.NewGuid():N}";
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private IEnumerable<string> GetErrors()
    {
        if (!string.IsNullOrEmpty(ErrorMessage))
        {
            yield return ErrorMessage;
        }

        if (EditContext != null && ValueExpression != null)
        {
            foreach (var msg in EditContext.GetValidationMessages(FieldIdentifier))
            {
                yield return msg;
            }
        }
    }

    private bool HasError => GetErrors().Any();
    private string GetFirstError() => GetErrors().FirstOrDefault() ?? string.Empty;

    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        try
        {
            if (typeof(TValue) == typeof(string))
            {
                result = (TValue)(object)(value ?? string.Empty);
                validationErrorMessage = null;
                return true;
            }

            if (string.IsNullOrEmpty(value))
            {
                result = default!;
                validationErrorMessage = null;
                return true;
            }

            var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            if (targetType.IsEnum)
            {
                result = (TValue)Enum.Parse(targetType, value);
                validationErrorMessage = null;
                return true;
            }

            // Guid, DateOnly, TimeOnly... ne sont pas IConvertible : Convert.ChangeType les refuse, TypeConverter les gère
            var converted = typeof(IConvertible).IsAssignableFrom(targetType)
                ? Convert.ChangeType(value, targetType, System.Globalization.CultureInfo.InvariantCulture)
                : System.ComponentModel.TypeDescriptor.GetConverter(targetType).ConvertFromInvariantString(value);

            result = (TValue)converted!;
            validationErrorMessage = null;
            return true;
        }
        catch (Exception ex)
        {
            result = default!;
            validationErrorMessage = $"Valeur invalide : {ex.Message}";
            return false;
        }
    }

    private void HandleChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

    private bool IsRequiredByAttribute()
    {
        if (EditContext != null && ValueExpression != null)
        {
            var memberExpression = ValueExpression.Body as System.Linq.Expressions.MemberExpression;
            if (memberExpression != null)
            {
                var property = memberExpression.Member;
                return property.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.RequiredAttribute), true).Any();
            }
        }
        return false;
    }
}
