@inherits UiInputBase<TimeSpan?>
@namespace WaesesUI

<UiFormField For="@Id" Label="@Label" HelperText="@HelperText" Error="@GetFirstError()" Required="@Required" Class="@Class" Style="@Style">
    <input id="@Id" aria-invalid="@AriaInvalid" aria-describedby="@DescribedBy" aria-required="@(IsRequired ? "true" : null)" type="time" class="ui-input @CssClass" value="@CurrentValueAsString" min="@Min" max="@Max" step="@Step" disabled="@Disabled" @onchange="HandleChange" @attributes="AdditionalAttributes" />
</UiFormField>

@code {
    protected override string IdPrefix => "time";

    /// <summary>Heure minimale au format <c>HH:mm</c>.</summary>
    [Parameter] public string? Min { get; set; }
    /// <summary>Heure maximale au format <c>HH:mm</c>.</summary>
    [Parameter] public string? Max { get; set; }
    /// <summary>Pas en secondes (60 : à la minute, 900 : au quart d'heure).</summary>
    [Parameter] public int Step { get; set; } = 60;

    private void HandleChange(ChangeEventArgs args) => CurrentValueAsString = args.Value?.ToString();

    protected override string? FormatValueAsString(TimeSpan? value) => value?.ToString(@"hh\:mm");

    protected override bool TryParseValueFromString(string? value, out TimeSpan? result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            validationErrorMessage = null;
            return true;
        }
        if (TimeSpan.TryParseExact(value, new[] { @"hh\:mm", @"hh\:mm\:ss" }, CultureInfo.InvariantCulture, out var parsed))
        {
            result = parsed;
            validationErrorMessage = null;
            return true;
        }
        result = null;
        validationErrorMessage = "L'heure n'est pas valide.";
        return false;
    }
}
