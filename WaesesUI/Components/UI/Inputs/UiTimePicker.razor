@inherits InputBase<TimeSpan?>
@namespace WaesesUI

<UiFormField For="@Id" Label="@Label" HelperText="@HelperText" Error="@GetFirstError()" Required="@Required" Class="@Class" Style="@Style">
    <input id="@Id" type="time" class="ui-input @CssClass" value="@CurrentValueAsString" min="@Min" max="@Max" step="@Step" disabled="@Disabled" @onchange="HandleChange" @attributes="AdditionalAttributes" />
</UiFormField>

@code {
    [Parameter] public string? Id { get; set; } = $"time-{Guid.NewGuid():N}";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Min { get; set; }
    [Parameter] public string? Max { get; set; }
    [Parameter] public int Step { get; set; } = 60;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private void HandleChange(ChangeEventArgs args) => CurrentValueAsString = args.Value?.ToString();

    private IEnumerable<string> GetErrors()
    {
        if (EditContext != null && ValueExpression != null)
            foreach (var error in EditContext.GetValidationMessages(FieldIdentifier)) yield return error;
    }

    private string GetFirstError() => GetErrors().FirstOrDefault() ?? string.Empty;

    protected override string? FormatValueAsString(TimeSpan? value) => value?.ToString(@"hh\:mm");

    protected override bool TryParseValueFromString(string? value, out TimeSpan? result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            validationErrorMessage = null;
            return true;
        }
        if (TimeSpan.TryParseExact(value, new[] { @"hh\:mm", @"hh\:mm\:ss" }, CultureInfo.InvariantCulture, out var parsed))
        {
            result = parsed;
            validationErrorMessage = null;
            return true;
        }
        result = null;
        validationErrorMessage = "L'heure n'est pas valide.";
        return false;
    }
}
