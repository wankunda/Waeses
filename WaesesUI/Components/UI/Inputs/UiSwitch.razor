@inherits InputBase<bool>
@namespace WaesesUI

<div class="ui-choice-item @(CurrentValue ? "ui-switch-active" : "") @(Disabled ? "disabled" : "") @CssClass @Class"
     @onclick="Toggle"
     role="switch"
     aria-checked="@CurrentValue"
     tabindex="@(Disabled ? -1 : 0)"
     @onkeydown="HandleKeyDown"
     @attributes="AdditionalAttributes">
    <div class="ui-switch-track">
        <div class="ui-switch-thumb"></div>
    </div>
    @if (ChildContent != null)
    {
        <span>@ChildContent</span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <span>@Label</span>
    }
</div>

@if (HasError)
{
    <div class="ui-error-text" style="margin-top: 0.25rem;">
        <span>⚠</span>
        <span>@GetFirstError()</span>
    </div>
}

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? Class { get; set; }

    private IEnumerable<string> GetErrors()
    {
        if (!string.IsNullOrEmpty(ErrorMessage))
        {
            yield return ErrorMessage;
        }

        if (EditContext != null && ValueExpression != null)
        {
            foreach (var msg in EditContext.GetValidationMessages(FieldIdentifier))
            {
                yield return msg;
            }
        }
    }

    private bool HasError => GetErrors().Any();
    private string GetFirstError() => GetErrors().FirstOrDefault() ?? string.Empty;

    protected override bool TryParseValueFromString(string? value, out bool result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (bool.TryParse(value, out result))
        {
            validationErrorMessage = null;
            return true;
        }
        result = default;
        validationErrorMessage = "La valeur doit être vraie ou fausse.";
        return false;
    }

    private void Toggle()
    {
        if (Disabled) return;
        CurrentValue = !CurrentValue;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is " " or "Enter")
        {
            Toggle();
        }
    }
}
