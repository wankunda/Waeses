@inherits UiInputBase<bool>
@namespace WaesesUI

<div class="ui-choice-item @(CurrentValue ? "ui-switch-active" : "") @(Disabled ? "disabled" : "") @CssClass @ColorClass @Class"
     @onclick="Toggle"
     role="switch"
     aria-checked="@(CurrentValue ? "true" : "false")"
     aria-disabled="@(Disabled ? "true" : null)"
     tabindex="@(Disabled ? -1 : 0)"
     @onkeydown="HandleKeyDown"
     style="@Style"
     @attributes="AdditionalAttributes">
    <div class="ui-switch-track">
        <div class="ui-switch-thumb"></div>
    </div>
    @if (ChildContent != null)
    {
        <span>@ChildContent</span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <span>@Label</span>
    }
</div>

@if (HasError)
{
    <div class="ui-error-text" style="margin-top: 0.25rem;">
        <span>⚠</span>
        <span>@GetFirstError()</span>
    </div>
}

@code {
    protected override string IdPrefix => "switch";

    /// <summary>Libellé libre de l'interrupteur (remplace <c>Label</c>).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override bool TryParseValueFromString(string? value, out bool result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (bool.TryParse(value, out result))
        {
            validationErrorMessage = null;
            return true;
        }
        result = default;
        validationErrorMessage = "La valeur doit être vraie ou fausse.";
        return false;
    }

    private void Toggle()
    {
        if (Disabled) return;
        CurrentValue = !CurrentValue;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is " " or "Enter")
        {
            Toggle();
        }
    }
}
