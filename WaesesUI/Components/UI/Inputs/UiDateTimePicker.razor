@inherits UiInputBase<DateTime?>
@namespace WaesesUI

<div class="ui-form-group @FieldClass @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="ui-label" for="@Id">
            @Label
            @if (Required)
            {
                <span class="ui-label-required">*</span>
            }
        </label>
    }

    <div id="@Id" role="group" aria-invalid="@AriaInvalid" aria-describedby="@DescribedBy" class="ui-datetime-picker @(HasError ? "ui-datetime-picker-error" : "")">
        @if (Mode is UiDateTimeMode.Date or UiDateTimeMode.DateTime)
        {
            <select class="ui-select ui-datetime-part" aria-label="Jour" value="@_selectedDay" disabled="@Disabled" @onchange="HandleDayChanged">
                @for (var day = 1; day <= DaysInSelectedMonth; day++)
                {
                    <option value="@day">@day</option>
                }
            </select>

            <select class="ui-select ui-datetime-part ui-datetime-month" aria-label="Mois" value="@_selectedMonth" disabled="@Disabled" @onchange="HandleMonthChanged">
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                }
            </select>

            <select class="ui-select ui-datetime-part" aria-label="Année" value="@_selectedYear" disabled="@Disabled" @onchange="HandleYearChanged">
                @for (var year = YearMin; year <= YearMax; year++)
                {
                    <option value="@year">@year</option>
                }
            </select>
        }

        @if (Mode is UiDateTimeMode.Time or UiDateTimeMode.DateTime)
        {
            <select class="ui-select ui-datetime-part ui-datetime-hour" aria-label="Heure" value="@_selectedHour" disabled="@Disabled" @onchange="HandleHourChanged">
                @for (var hour = 0; hour < 24; hour++)
                {
                    <option value="@hour">@hour.ToString("D2")</option>
                }
            </select>

            <span class="ui-datetime-separator" aria-hidden="true">:</span>

            <select class="ui-select ui-datetime-part ui-datetime-minute" aria-label="Minutes" value="@_selectedMinute" disabled="@Disabled" @onchange="HandleMinuteChanged">
                @for (var minute = 0; minute < 60; minute += MinuteStep)
                {
                    <option value="@minute">@minute.ToString("D2")</option>
                }
            </select>
        }
    </div>

    <UiInputMessages Error="@(HasError ? GetFirstError() : null)" HelperText="@HelperText" ErrorId="@ErrorId" HelperId="@HelperId" />
</div>

@code {
    protected override string IdPrefix => "datetime";

    private int _selectedDay;
    private int _selectedMonth;
    private int _selectedYear;
    private int _selectedHour;
    private int _selectedMinute;
    private DateTime? _lastSyncedValue;
    private bool _partsInitialized;

    /// <summary>Ce que le champ saisit : <c>Date</c>, <c>Time</c> ou <c>DateTime</c>.</summary>
    [Parameter] public UiDateTimeMode Mode { get; set; } = UiDateTimeMode.DateTime;
    /// <summary>Première année proposée.</summary>
    [Parameter] public int YearMin { get; set; } = DateTime.Now.Year - 10;
    /// <summary>Dernière année proposée.</summary>
    [Parameter] public int YearMax { get; set; } = DateTime.Now.Year + 10;
    /// <summary>Pas des minutes proposées (par exemple 5 ou 15).</summary>
    [Parameter] public int MinuteStep { get; set; } = 5;
    /// <summary>Valeur minimale acceptée (date et heure sous forme de texte).</summary>
    [Parameter] public string? Min { get; set; }
    /// <summary>Valeur maximale acceptée (date et heure sous forme de texte).</summary>
    [Parameter] public string? Max { get; set; }

    private int DaysInSelectedMonth => DateTime.DaysInMonth(_selectedYear, _selectedMonth);

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        MinuteStep = Math.Clamp(MinuteStep, 1, 60);
        var value = CurrentValue ?? DateTime.Now;
        if (!_partsInitialized || _lastSyncedValue != CurrentValue)
        {
            SyncParts(value);
            _lastSyncedValue = CurrentValue;
            _partsInitialized = true;
        }

        YearMin = Math.Min(YearMin, _selectedYear);
        YearMax = Math.Max(YearMax, _selectedYear);
    }

    private void SyncParts(DateTime value)
    {
        _selectedYear = value.Year;
        _selectedMonth = value.Month;
        _selectedDay = value.Day;
        _selectedHour = value.Hour;
        _selectedMinute = AlignMinute(value.Minute);
    }

    private int AlignMinute(int minute) => Math.Min(59, minute - minute % MinuteStep);

    private Task HandleDayChanged(ChangeEventArgs args) => UpdatePartAsync(args, value => _selectedDay = value);
    private Task HandleMonthChanged(ChangeEventArgs args) => UpdatePartAsync(args, value => _selectedMonth = value);
    private Task HandleYearChanged(ChangeEventArgs args) => UpdatePartAsync(args, value => _selectedYear = value);
    private Task HandleHourChanged(ChangeEventArgs args) => UpdatePartAsync(args, value => _selectedHour = value);
    private Task HandleMinuteChanged(ChangeEventArgs args) => UpdatePartAsync(args, value => _selectedMinute = value);

    private async Task UpdatePartAsync(ChangeEventArgs args, Action<int> update)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value))
        {
            return;
        }

        update(value);
        _selectedDay = Math.Min(_selectedDay, DateTime.DaysInMonth(_selectedYear, _selectedMonth));

        var nextValue = new DateTime(_selectedYear, _selectedMonth, _selectedDay, _selectedHour, _selectedMinute, 0);
        if (IsOutsideBounds(nextValue))
        {
            SyncParts(CurrentValue ?? DateTime.Now);
            return;
        }

        CurrentValue = Mode == UiDateTimeMode.Date ? nextValue.Date : nextValue;
        _lastSyncedValue = CurrentValue;
        await InvokeAsync(StateHasChanged);
    }

    private bool IsOutsideBounds(DateTime value)
    {
        return TryParseConstraint(Min, out var min) && value < min
            || TryParseConstraint(Max, out var max) && value > max;
    }

    private bool TryParseConstraint(string? constraint, out DateTime value)
    {
        return DateTime.TryParse(constraint, CultureInfo.CurrentCulture, DateTimeStyles.None, out value)
            || DateTime.TryParse(constraint, CultureInfo.InvariantCulture, DateTimeStyles.None, out value);
    }

    protected override bool TryParseValueFromString(string? value, out DateTime? result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = CurrentValue;
        validationErrorMessage = null;
        return true;
    }
}
