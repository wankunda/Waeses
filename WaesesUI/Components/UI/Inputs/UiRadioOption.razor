@namespace WaesesUI
@inherits UiComponentBase
@typeparam TValue

<div class="ui-choice-item @(IsChecked ? "ui-radio-checked" : "") @(Disabled ? "disabled" : "") @Class"
     @onclick="HandleSelect"
     style="@Style" @attributes="AdditionalAttributes">
    <div class="ui-radio-outer">
        <div class="ui-radio-inner"></div>
    </div>
    @if (ChildContent != null)
    {
        <span>@ChildContent</span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <span>@Label</span>
    }
</div>

@code {
    [CascadingParameter] public UiRadioGroup<TValue>? ParentGroup { get; set; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool IsChecked => ParentGroup != null && EqualityComparer<TValue>.Default.Equals(ParentGroup.Value, Value);

    private async Task HandleSelect()
    {
        if (Disabled || ParentGroup == null) return;
        await ParentGroup.SelectValueAsync(Value);
    }
}
