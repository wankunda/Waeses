@typeparam TValue
@inherits InputBase<TValue>
@namespace WaesesUI

<div class="ui-form-group @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="ui-label" for="@Id">
            @Label
            @if (Required || IsRequiredByAttribute())
            {
                <span class="ui-label-required">*</span>
            }
        </label>
    }

    <div class="ui-input-wrapper">
        @if (!string.IsNullOrEmpty(PrefixIcon))
        {
            <span class="ui-input-prefix">
                @if (PrefixIcon.TrimStart().StartsWith("<"))
                {
                    <UiIcon Icon="@PrefixIcon" Size="UiSize.Sm" />
                }
                else
                {
                    @PrefixIcon
                }
            </span>
        }

        <input id="@Id"
               type="@EffectiveType"
               class="ui-input @CssClass @(HasError ? "ui-input-error" : "") @(!string.IsNullOrEmpty(PrefixIcon) ? "ui-input-has-prefix" : "") @((!string.IsNullOrEmpty(SuffixIcon) || Clearable || Type == "password") ? "ui-input-has-suffix" : "")"
               placeholder="@Placeholder"
               value="@CurrentValue"
               disabled="@Disabled"
               readonly="@ReadOnly"
               @oninput="HandleInput"
               @onchange="HandleChange"
               autocomplete="@Autocomplete"
               inputmode="@InputMode"
               maxlength="@MaxLength"
               min="@Min"
               max="@Max"
               step="@Step"
               @attributes="AdditionalAttributes" />

        <div class="ui-input-actions" style="position: absolute; right: 0.75rem; display: flex; align-items: center; gap: 0.35rem;">
            @if (Clearable && !string.IsNullOrEmpty(CurrentValueAsString) && !Disabled && !ReadOnly)
            {
                <button type="button"
                        class="ui-input-btn"
                        style="background: transparent; border: none; cursor: pointer; color: var(--text-muted); font-size: 0.85rem; padding: 0.2rem; display: flex; align-items: center;"
                        @onclick="ClearValue"
                        tabindex="-1"
                        title="Effacer le contenu">
                    ✕
                </button>
            }

            @if (Type == "password" && ShowPasswordToggle && !Disabled && !ReadOnly)
            {
                <button type="button"
                        class="ui-input-btn"
                        style="background: transparent; border: none; cursor: pointer; color: var(--text-muted); padding: 0.2rem; display: flex; align-items: center;"
                        @onclick="TogglePasswordVisibility"
                        aria-label="@(_showPassword ? "Masquer le mot de passe" : "Afficher le mot de passe")"
                        aria-pressed="@_showPassword"
                        title="@(_showPassword ? "Masquer le mot de passe" : "Afficher le mot de passe")">
                    @if (_showPassword)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                        </svg>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    }
                </button>
            }

            @if (!string.IsNullOrEmpty(SuffixIcon) && Type != "password")
            {
                <span class="ui-input-suffix-static" style="color: var(--text-muted); display: flex; align-items: center;">
                    @if (SuffixIcon.TrimStart().StartsWith("<"))
                    {
                        <UiIcon Icon="@SuffixIcon" Size="UiSize.Sm" />
                    }
                    else
                    {
                        @SuffixIcon
                    }
                </span>
            }
        </div>
    </div>

    @if (HasError)
    {
        <div class="ui-error-text">
            <span>⚠</span>
            <span>@GetFirstError()</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="ui-helper-text">
            @HelperText
        </div>
    }
</div>

@code {
    private bool _showPassword;

    [Parameter] public string? Id { get; set; } = $"input-{Guid.NewGuid():N}";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? PrefixIcon { get; set; }
    [Parameter] public string? SuffixIcon { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool ShowPasswordToggle { get; set; } = true;
    [Parameter] public string? Autocomplete { get; set; }
    [Parameter] public string? InputMode { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public string? Min { get; set; }
    [Parameter] public string? Max { get; set; }
    [Parameter] public string? Step { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private string EffectiveType => Type == "password" ? (_showPassword ? "text" : "password") : Type;

    private IEnumerable<string> GetErrors()
    {
        if (!string.IsNullOrEmpty(ErrorMessage))
        {
            yield return ErrorMessage;
        }

        if (EditContext != null && ValueExpression != null)
        {
            foreach (var msg in EditContext.GetValidationMessages(FieldIdentifier))
            {
                yield return msg;
            }
        }
    }

    private bool HasError => GetErrors().Any();
    private string GetFirstError() => GetErrors().FirstOrDefault() ?? string.Empty;

    protected override bool TryParseValueFromString(string? value, out TValue result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (BindConverter.TryConvertTo<TValue>(value, CultureInfo.CurrentCulture, out var parsedValue))
        {
            result = parsedValue!;
            validationErrorMessage = null;
            return true;
        }

        result = default!;
        validationErrorMessage = $"La valeur « {value} » n'est pas valide.";
        return false;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

    private void HandleChange(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

    private void ClearValue()
    {
        CurrentValue = default!;
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private bool IsRequiredByAttribute()
    {
        if (EditContext != null && ValueExpression != null)
        {
            var memberExpression = ValueExpression.Body as MemberExpression;
            if (memberExpression != null)
            {
                var property = memberExpression.Member;
                return property.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.RequiredAttribute), true).Any();
            }
        }
        return false;
    }
}
