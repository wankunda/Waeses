@namespace WaesesUI
@inherits UiComponentBase

<div class="ui-image-wrapper @GetRatioClass() @(Circle ? "ui-image-circle" : (Rounded ? "ui-image-rounded" : "")) @(HoverZoom ? "ui-image-hover-zoom" : "") @Class"
     style="@Style"
     @attributes="AdditionalAttributes">
    
    @if (_isLoading)
    {
        <div class="ui-image-skeleton"></div>
    }

    <img class="ui-image @(_isLoading ? "ui-image-loading" : "")"
         src="@(_hasError ? FallbackSrc : Src)"
         alt="@Alt"
         loading="@(Lazy ? "lazy" : "eager")"
         @onload="HandleLoaded"
         @onerror="HandleError" />

    @if (!string.IsNullOrEmpty(Caption))
    {
        <div class="ui-image-caption">
            @Caption
        </div>
    }
</div>

@code {
    private bool _isLoading = true;
    private bool _hasError;

    /// <summary>Adresse de l'image.</summary>
    [Parameter] public string? Src { get; set; }
    /// <summary>Texte alternatif de l'image.</summary>
    [Parameter] public string? Alt { get; set; } = "Image";
    /// <summary>Légende affichée sous l'image.</summary>
    [Parameter] public string? Caption { get; set; }
    /// <summary>Rapport largeur/hauteur imposé au cadre (évite le décalage de mise en page au chargement).</summary>
    [Parameter] public ImageRatio Ratio { get; set; } = ImageRatio.Auto;
    /// <summary>Arrondit les angles.</summary>
    [Parameter] public bool Rounded { get; set; } = true;
    /// <summary>Découpe l'image en cercle.</summary>
    [Parameter] public bool Circle { get; set; }
    /// <summary>Agrandit légèrement l'image au survol.</summary>
    [Parameter] public bool HoverZoom { get; set; } = true;
    /// <summary>Charge l'image seulement quand elle approche de l'écran.</summary>
    [Parameter] public bool Lazy { get; set; } = true;
    /// <summary>Image de remplacement affichée si <c>Src</c> ne se charge pas.</summary>
    [Parameter] public string? FallbackSrc { get; set; }

    private string? _lastSrc;

    protected override void OnParametersSet()
    {
        if (_lastSrc != Src)
        {
            _lastSrc = Src;
            _isLoading = true;
            _hasError = false;
        }
    }

    private void HandleLoaded()
    {
        _isLoading = false;
    }

    private void HandleError()
    {
        _isLoading = false;
        if (!_hasError && !string.IsNullOrEmpty(FallbackSrc))
        {
            _hasError = true;
        }
    }

    private string GetRatioClass() => Ratio switch
    {
        ImageRatio.Square => "ui-image-ratio-1-1",
        ImageRatio.Widescreen => "ui-image-ratio-16-9",
        ImageRatio.Standard => "ui-image-ratio-4-3",
        ImageRatio.Photo => "ui-image-ratio-3-2",
        _ => string.Empty
    };
}
