@namespace WaesesUI

<section class="ui-carousel @Class" aria-roledescription="carrousel" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
    @if (Items.Count > 0)
    {
        <div class="ui-carousel-stage" aria-live="polite">
            <UiImage Src="@CurrentItem.Src" Alt="@CurrentItem.Alt" Ratio="@Ratio" Lazy="false" />
            @if (!string.IsNullOrWhiteSpace(CurrentItem.Caption)) { <div class="ui-carousel-caption">@CurrentItem.Caption</div> }
            @if (Items.Count > 1)
            {
                <button type="button" class="ui-carousel-control previous" aria-label="@PreviousText" @onclick="Previous">‹</button>
                <button type="button" class="ui-carousel-control next" aria-label="@NextText" @onclick="Next">›</button>
            }
        </div>
        <div class="ui-carousel-footer">
            <span>@(_activeIndex + 1) / @Items.Count</span>
            <div class="ui-carousel-dots" role="tablist" aria-label="Sélection de l’image">
                @for (var index = 0; index < Items.Count; index++)
                {
                    var capturedIndex = index;
                    <button type="button" role="tab" class="@(capturedIndex == _activeIndex ? "active" : "")" aria-label="Image @(capturedIndex + 1)" aria-selected="@(capturedIndex == _activeIndex)" @onclick="() => Select(capturedIndex)"></button>
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<UiCarouselItem> Items { get; set; } = Array.Empty<UiCarouselItem>();
    [Parameter] public int ActiveIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }
    [Parameter] public ImageRatio Ratio { get; set; } = ImageRatio.Widescreen;
    [Parameter] public string AriaLabel { get; set; } = "Carrousel";
    [Parameter] public string PreviousText { get; set; } = "Image précédente";
    [Parameter] public string NextText { get; set; } = "Image suivante";
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int _activeIndex;
    private int SafeIndex => Math.Clamp(_activeIndex, 0, Math.Max(Items.Count - 1, 0));
    private UiCarouselItem CurrentItem => Items[SafeIndex];

    protected override void OnParametersSet() => _activeIndex = Items.Count == 0 ? 0 : Math.Clamp(ActiveIndex, 0, Items.Count - 1);

    private Task Previous() => SelectAsync((SafeIndex - 1 + Items.Count) % Items.Count);
    private Task Next() => SelectAsync((SafeIndex + 1) % Items.Count);
    private Task Select(int index) => SelectAsync(index);

    private async Task SelectAsync(int index)
    {
        _activeIndex = index;
        await ActiveIndexChanged.InvokeAsync(index);
    }
}
