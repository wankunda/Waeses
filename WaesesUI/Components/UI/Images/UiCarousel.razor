@namespace WaesesUI
@inherits UiComponentBase
@implements IDisposable

<section class="@CssClass"
         style="@Style"
         tabindex="0"
         aria-roledescription="carrousel"
         aria-label="@AriaLabel"
         @onkeydown="HandleKeyDown"
         @onmouseenter="() => SetPaused(true)"
         @onmouseleave="() => SetPaused(false)"
         @onfocusin="() => SetPaused(true)"
         @onfocusout="() => SetPaused(false)"
         @attributes="AdditionalAttributes">
    @if (Items.Count > 0)
    {
        <div class="ui-carousel-stage"
             aria-live="@(IsCycling ? "off" : "polite")"
             @ontouchstart="HandleTouchStart"
             @ontouchend="HandleTouchEnd">
            <div class="ui-carousel-track" style="@TrackStyle">
                @for (var index = 0; index < Items.Count; index++)
                {
                    var item = Items[index];
                    var isActive = index == SafeIndex;
                    <div class="@(isActive ? "ui-carousel-slide active" : "ui-carousel-slide")"
                         role="group"
                         aria-roledescription="diapositive"
                         aria-label="@SlideLabel(index)"
                         aria-hidden="@(isActive ? null : "true")"
                         @key="index">
                        @if (ItemTemplate != null)
                        {
                            @ItemTemplate(item)
                        }
                        else
                        {
                            <UiImage Src="@item.Src" Alt="@item.Alt" Ratio="@Ratio" Lazy="@(!isActive)" />
                            @if (!string.IsNullOrWhiteSpace(item.Caption))
                            {
                                <div class="ui-carousel-caption">@item.Caption</div>
                            }
                        }
                    </div>
                }
            </div>
            @if (ShowArrows && Items.Count > 1)
            {
                <button type="button" class="ui-carousel-control previous" aria-label="@PreviousText"
                        disabled="@(!Loop && SafeIndex == 0)" @onclick="PreviousAsync">‹</button>
                <button type="button" class="ui-carousel-control next" aria-label="@NextText"
                        disabled="@(!Loop && SafeIndex == Items.Count - 1)" @onclick="NextAsync">›</button>
            }
        </div>
        @if (ShowBullets || ShowCounter)
        {
            <div class="ui-carousel-footer">
                @if (ShowCounter) { <span>@(SafeIndex + 1) / @Items.Count</span> } else { <span></span> }
                @if (ShowBullets)
                {
                    <div class="ui-carousel-dots">
                        @for (var index = 0; index < Items.Count; index++)
                        {
                            var capturedIndex = index;
                            <button type="button"
                                    class="@(capturedIndex == SafeIndex ? "active" : "")"
                                    aria-label="@SlideLabel(capturedIndex)"
                                    aria-current="@(capturedIndex == SafeIndex ? "true" : null)"
                                    @onclick="() => SelectAsync(capturedIndex)"></button>
                        }
                    </div>
                }
            </div>
        }
    }
</section>

@code {
    private int _index;
    private int _lastIndexParameter = -1;
    private bool _paused;
    private int _touchStartX;
    private bool _touching;
    private Timer? _timer;
    private (bool Cycle, int Interval, int Count) _timerConfig;

    [Parameter] public IReadOnlyList<UiCarouselItem> Items { get; set; } = Array.Empty<UiCarouselItem>();

    /// <summary>Contenu personnalisé d'une diapositive (remplace l'image et la légende).</summary>
    [Parameter] public RenderFragment<UiCarouselItem>? ItemTemplate { get; set; }

    /// <summary>Index affiché. Optionnel : sans liaison, le carrousel garde son propre état.</summary>
    [Parameter] public int ActiveIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }
    [Parameter] public ImageRatio Ratio { get; set; } = ImageRatio.Widescreen;
    [Parameter] public UiCarouselTransition Transition { get; set; } = UiCarouselTransition.Slide;

    /// <summary>Revient à la première diapositive après la dernière (et inversement).</summary>
    [Parameter] public bool Loop { get; set; } = true;
    [Parameter] public bool AutoCycle { get; set; }
    [Parameter] public int AutoCycleInterval { get; set; } = 5000;

    /// <summary>Suspend le défilement automatique au survol et au focus.</summary>
    [Parameter] public bool PauseOnHover { get; set; } = true;
    [Parameter] public bool ShowArrows { get; set; } = true;
    [Parameter] public bool ShowBullets { get; set; } = true;
    [Parameter] public bool ShowCounter { get; set; } = true;

    /// <summary>Navigation par glissement tactile.</summary>
    [Parameter] public bool EnableSwipe { get; set; } = true;
    [Parameter] public string AriaLabel { get; set; } = "Carrousel";
    [Parameter] public string PreviousText { get; set; } = "Image précédente";
    [Parameter] public string NextText { get; set; } = "Image suivante";

    private int SafeIndex => Math.Clamp(_index, 0, Math.Max(Items.Count - 1, 0));
    private bool IsCycling => AutoCycle && Items.Count > 1;

    private string CssClass => CssBuilder.Default("ui-carousel")
        .Add($"ui-carousel-transition-{Transition.ToString().ToLowerInvariant()}")
        .Add(Class)
        .Build();

    private string? TrackStyle => Transition == UiCarouselTransition.Slide
        ? $"transform: translateX(-{SafeIndex * 100}%);"
        : null;

    private string SlideLabel(int index) => $"{index + 1} / {Items.Count}";

    protected override void OnParametersSet()
    {
        // Le paramètre ne pilote l'état que lorsqu'il change : un re-rendu du parent ne ramène plus à l'index initial.
        if (ActiveIndex != _lastIndexParameter)
        {
            _lastIndexParameter = ActiveIndex;
            _index = ActiveIndex;
        }
        _index = Items.Count == 0 ? 0 : Math.Clamp(_index, 0, Items.Count - 1);
        ConfigureTimer();
    }

    private void ConfigureTimer()
    {
        var config = (IsCycling, Math.Max(AutoCycleInterval, 500), Items.Count);
        if (config == _timerConfig && (_timer != null || !config.Item1)) return;

        _timerConfig = config;
        _timer?.Dispose();
        _timer = null;
        if (config.Item1)
        {
            _timer = new Timer(_ => _ = InvokeAsync(TickAsync), null, config.Item2, config.Item2);
        }
    }

    private async Task TickAsync()
    {
        if (_paused || Items.Count < 2) return;
        await NextAsync();
    }

    private void SetPaused(bool paused)
    {
        if (PauseOnHover) _paused = paused;
    }

    private Task PreviousAsync() => MoveAsync(-1);
    private Task NextAsync() => MoveAsync(1);

    private Task MoveAsync(int step)
    {
        if (Items.Count < 2) return Task.CompletedTask;
        var target = SafeIndex + step;
        if (Loop) target = (target % Items.Count + Items.Count) % Items.Count;
        else if (target < 0 || target >= Items.Count) return Task.CompletedTask;
        return SelectAsync(target);
    }

    private async Task SelectAsync(int index)
    {
        if (index == SafeIndex || index < 0 || index >= Items.Count) return;
        _index = index;
        await ActiveIndexChanged.InvokeAsync(index);
        StateHasChanged();
    }

    private Task HandleKeyDown(KeyboardEventArgs e) => e.Key switch
    {
        "ArrowLeft" => PreviousAsync(),
        "ArrowRight" => NextAsync(),
        "Home" => SelectAsync(0),
        "End" => SelectAsync(Items.Count - 1),
        _ => Task.CompletedTask
    };

    private void HandleTouchStart(TouchEventArgs e)
    {
        if (!EnableSwipe || e.Touches.Length != 1) return;
        _touchStartX = (int)e.Touches[0].ClientX;
        _touching = true;
    }

    private async Task HandleTouchEnd(TouchEventArgs e)
    {
        if (!_touching || e.ChangedTouches.Length == 0) return;
        _touching = false;
        var delta = (int)e.ChangedTouches[0].ClientX - _touchStartX;
        if (Math.Abs(delta) < 40) return;
        await (delta < 0 ? NextAsync() : PreviousAsync());
    }

    public void Dispose() => _timer?.Dispose();
}
