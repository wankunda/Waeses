@namespace WaesesUI
@inherits UiComponentBase

<article class="ui-file-preview @Class" style="@Style" @attributes="AdditionalAttributes">
    <UiIcon Icon="@GetIcon()" Size="UiSize.Lg" Color="UiColor.Primary" aria-hidden="true" />
    <div class="ui-file-preview-info">
        <strong>@FileName</strong>
        @if (!string.IsNullOrWhiteSpace(ContentType) || SizeBytes.HasValue) { <small>@ContentType @FormatSize()</small> }
    </div>
    @if (!string.IsNullOrWhiteSpace(Url))
    {
        <a class="ui-btn ui-btn-ghost ui-btn-sm" href="@Url" target="_blank" rel="noopener" download="@FileName">Ouvrir</a>
    }
</article>

@code {
    /// <summary>Nom du fichier affiché.</summary>
    [Parameter] public string FileName { get; set; } = "Fichier";
    /// <summary>Type MIME : détermine l'icône et l'aperçu.</summary>
    [Parameter] public string? ContentType { get; set; }
    /// <summary>Taille en octets, affichée en unité lisible.</summary>
    [Parameter] public long? SizeBytes { get; set; }
    /// <summary>Adresse du fichier, pour l'aperçu et le téléchargement.</summary>
    [Parameter] public string? Url { get; set; }

    private string FormatSize() => !SizeBytes.HasValue ? string.Empty : SizeBytes.Value switch
    {
        < 1024 => $"· {SizeBytes} o",
        < 1024 * 1024 => $"· {SizeBytes.Value / 1024d:0.#} Ko",
        _ => $"· {SizeBytes.Value / (1024d * 1024d):0.#} Mo"
    };

    private string GetIcon() => ContentType?.ToLowerInvariant() switch
    {
        "application/pdf" => Icons.Custom.FileFormats.FilePdf,
        "image/jpeg" or "image/png" or "image/webp" => Icons.Custom.FileFormats.FileImage,
        _ => Icons.Custom.FileFormats.FileDocument
    };
}
