@inject IThemeService ThemeService
@implements IDisposable
@namespace WaesesUI

<div class="page">
    @NavMenu
    <main class="min-h-100 d-flex flex-column">
        <header class="d-flex justify-space-between align-center position-sticky"
                style="background: var(--bg-surface); border-bottom: 1px solid var(--border-default); padding: calc(0.85rem + env(safe-area-inset-top, 0px)) calc(1.5rem + env(safe-area-inset-right, 0px)) 0.85rem calc(1.5rem + env(safe-area-inset-left, 0px)); top: 0; z-index: 100; backdrop-filter: blur(10px);">
            <div class="d-flex align-center justify-center gap-sm">
                @if (!string.IsNullOrWhiteSpace(BrandIcon))
                {
                    <span class="h6">@BrandIcon</span>
                }
                <span class="h6"
                      style="background: linear-gradient(135deg, var(--primary), var(--info)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    @BrandText
                </span>

                @if (!string.IsNullOrWhiteSpace(VersionText))
                {
                    <span class="ui-badge ui-badge-primary" style="font-size: 0.7rem;">@VersionText</span>
                }
            </div>

            @if (ShowThemeToggle)
        {
            <div class="d-flex align-center gap-sm">
                <UiTooltip Text="@ModeText" Position="TooltipPosition.Left">
                    <button type="button" class="ui-btn ui-btn-secondary ui-btn-sm"
                            style="border-radius: var(--radius-full); padding: 0.4rem 0.85rem;" @onclick="ToggleTheme">
                        <span>@ModeIcon</span>
                            <span class="mode-theme-text">@ModeText</span>
                    </button>
                </UiTooltip>
            </div>
        }
        </header>

        <article style="flex: 1;">
            @MainBody
        </article>
    </main>
</div>
@if (ShowFooter)
{
    <footer class="position-sticky w-100 d-flex justify-center align-center p-md"
            style="background: var(--bg-surface); border-top: 1px solid var(--border-default); bottom: 0; z-index: 1000; left: 0; right: 0; padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));">
        @if (FooterText != string.Empty)
        {
            <span style="font-size: 0.85rem; color: var(--text-secondary);">
                @(FooterText ?? $"© {DateTime.Now.Year} Waeses. All rights reserved.")
            </span>
        }
        @Footer
    </footer>
}

@code {
    /// <summary>Nom de l'application, affiché dans l'en-tête.</summary>
    [Parameter] public string BrandText { get; set; } = "Waeses UI";
    /// <summary>Icône ou emoji devant le nom.</summary>
    [Parameter] public string? BrandIcon { get; set; } = "⚡";
    /// <summary>Texte du badge de version dans l'en-tête. Vide ou <c>null</c> : aucun badge.</summary>
    [Parameter] public string? VersionText { get; set; } = "1.0";
    /// <summary>Affiche le bouton clair/sombre dans l'en-tête.</summary>
    [Parameter] public bool ShowThemeToggle { get; set; } = true;
    /// <summary>Indique si le mode sombre est actif.</summary>
    [Parameter] public bool IsDarkMode { get; set; }
    /// <summary>Appelé quand l'utilisateur change de mode.</summary>
    [Parameter] public EventCallback<bool> IsDarkModeChanged { get; set; }
    string ModeText => IsDarkMode ? "Mode Clair" : "Mode Sombre";
    string ModeIcon => IsDarkMode ? "☀️" : "🌙";
    /// <summary>Contenu de la page (le <c>Body</c> du layout Blazor).</summary>
    [Parameter] public RenderFragment? MainBody { get; set; }
    /// <summary>Contenu supplémentaire du pied de page.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>Affiche le pied de page (texte et fragment <see cref="Footer"/>). Vrai par défaut.</summary>
    [Parameter] public bool ShowFooter { get; set; } = true;

    /// <summary>Texte du pied de page. Null : « © année Waeses. All rights reserved. » ; chaîne vide : aucun texte.</summary>
    [Parameter] public string? FooterText { get; set; }
    /// <summary>Menu de navigation latéral, généralement un <c>UiNavMenu</c>.</summary>
    [Parameter] public RenderFragment? NavMenu { get; set; }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeThemeAsync();
            IsDarkMode = ThemeService.IsDarkMode;
            await IsDarkModeChanged.InvokeAsync(IsDarkMode);
            ThemeService.OnThemeChanged += HandleThemeChanged;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
        IsDarkMode = ThemeService.IsDarkMode;
        await IsDarkModeChanged.InvokeAsync(IsDarkMode);
    }

    private async void HandleThemeChanged()
    {
        IsDarkMode = ThemeService.IsDarkMode;
        await IsDarkModeChanged.InvokeAsync(IsDarkMode);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}