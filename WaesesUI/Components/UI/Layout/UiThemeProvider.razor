@namespace WaesesUI
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject UiOptions Options

@if (_themeCss is { Length: > 0 })
{
    <style data-ui-theme>@((MarkupString)_themeCss)</style>
}
<span hidden aria-hidden="true"></span>

@code {
    // Configuration voulue (mise à jour à chaque OnParametersSet) et configuration réellement appliquée côté navigateur.
    // On compare les deux après le rendu : un booléen « changé » serait écrasé si le parent se re-rend deux fois
    // avant OnAfterRenderAsync (typique d'un BlazorWebView), et le thème ne serait alors jamais appliqué.
    private string? _wantedConfiguration;
    private string? _appliedConfiguration;
    private string? _themeCss;

    /// <summary>Densité de l'interface : compacte, confortable ou spacieuse.</summary>
    [Parameter] public UiDensity Density { get; set; } = UiDensity.Comfortable;
    /// <summary>Mode : clair, sombre ou celui du système.</summary>
    [Parameter] public UiTheme Theme { get; set; } = UiTheme.System;
    /// <summary>
    /// Thème décrit en C# (couleurs claires/sombres, typographie, rayons). Par défaut <see cref="UiOptions.Theme"/>.
    /// Lorsqu'il est défini, il remplace les palettes <see cref="Primary"/>… ci-dessous.
    /// </summary>
    [Parameter] public UiThemeDefinition? Definition { get; set; }

    /// <summary>Palette primaire. Ignorée si <c>Definition</c> est défini.</summary>
    [Parameter] public UiColorPalette Primary { get; set; } = UiColors.Indigo;
    /// <summary>Palette secondaire. Ignorée si <c>Definition</c> est défini.</summary>
    [Parameter] public UiColorPalette Secondary { get; set; } = UiColors.BlueGray;
    /// <summary>Palette de succès. Ignorée si <c>Definition</c> est défini.</summary>
    [Parameter] public UiColorPalette Success { get; set; } = UiColors.Green;
    /// <summary>Palette de danger. Ignorée si <c>Definition</c> est défini.</summary>
    [Parameter] public UiColorPalette Danger { get; set; } = UiColors.Red;
    /// <summary>Palette d'avertissement. Ignorée si <c>Definition</c> est défini.</summary>
    [Parameter] public UiColorPalette Warning { get; set; } = UiColors.Amber;
    /// <summary>Palette d'information. Ignorée si <c>Definition</c> est défini.</summary>
    [Parameter] public UiColorPalette Info { get; set; } = UiColors.LightBlue;

    protected override void OnParametersSet()
    {
        _themeCss = (Definition ?? Options.Theme)?.ToCss();
        _wantedConfiguration = $"{_themeCss}|{Theme}|{Density}|{Primary.Name}|{Secondary.Name}|{Success.Name}|{Danger.Name}|{Warning.Name}|{Info.Name}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.Equals(_wantedConfiguration, _appliedConfiguration, StringComparison.Ordinal))
        {
            return;
        }

        _appliedConfiguration = _wantedConfiguration;
        try
        {
            await JS.InvokeVoidAsync("UiInterop.applyGlobalTheme", Theme.ToString().ToLowerInvariant(), Density.ToString().ToLowerInvariant(), GetPaletteTokens());
        }
        catch (JSDisconnectedException)
        {
        }
    }

    // Une définition de thème remplace les palettes : les variables posées en ligne sur la racine l'emporteraient sinon sur la feuille générée.
    private Dictionary<string, string> GetPaletteTokens() => (Definition ?? Options.Theme) is not null ? new() : GetLegacyPaletteTokens();

    private Dictionary<string, string> GetLegacyPaletteTokens() => new()
    {
        ["primary"] = Primary.Default,
        ["primary-hover"] = Primary.Darken1,
        ["primary-active"] = Primary.Darken2,
        ["primary-light"] = Primary.Lighten5,
        ["primary-subtle"] = Primary.Lighten4,
        ["primary-contrast"] = GetContrast(Primary.Default),
        ["secondary"] = Secondary.Default,
        ["secondary-hover"] = Secondary.Darken1,
        ["secondary-light"] = Secondary.Lighten5,
        ["secondary-contrast"] = GetContrast(Secondary.Default),
        ["success"] = Success.Default,
        ["success-hover"] = Success.Darken1,
        ["success-light"] = Success.Lighten5,
        ["success-contrast"] = GetContrast(Success.Default),
        ["danger"] = Danger.Default,
        ["danger-hover"] = Danger.Darken1,
        ["danger-light"] = Danger.Lighten5,
        ["danger-contrast"] = GetContrast(Danger.Default),
        ["warning"] = Warning.Default,
        ["warning-hover"] = Warning.Darken1,
        ["warning-light"] = Warning.Lighten5,
        ["warning-contrast"] = GetContrast(Warning.Default),
        ["info"] = Info.Default,
        ["info-hover"] = Info.Darken1,
        ["info-light"] = Info.Lighten5,
        ["info-contrast"] = GetContrast(Info.Default)
    };

    private static string GetContrast(string hex) => UiColorMath.Contrast(hex);

    public async ValueTask DisposeAsync()
    {
        await JS.TryTeardownAsync("UiInterop.clearGlobalTheme");
    }
}
