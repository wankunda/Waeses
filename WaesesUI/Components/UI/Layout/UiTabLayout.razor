@inject IThemeService ThemeService
@implements IDisposable
@namespace WaesesUI
@inherits UiComponentBase

@* Même principe que UiLayout et UiSimpleLayout : en-tête (nom, bouton clair/sombre), contenu (MainBody), pied de page.
   La navigation est une barre d'onglets (icône et libellé), en haut sous l'en-tête ou en bas de l'écran. *@
<div class="@RootClass" style="@Style" @attributes="AdditionalAttributes">
    <div class="ui-tablayout-head">
        <header class="d-flex justify-space-between align-center"
                style="background: var(--bg-surface); border-bottom: 1px solid var(--border-default); padding: calc(0.85rem + env(safe-area-inset-top, 0px)) calc(1.5rem + env(safe-area-inset-right, 0px)) 0.85rem calc(1.5rem + env(safe-area-inset-left, 0px)); backdrop-filter: blur(10px);">
            <div class="d-flex align-center justify-center gap-sm">
                @if (!string.IsNullOrWhiteSpace(BrandIcon))
                {
                    <span class="h6">@BrandIcon</span>
                }
                <span class="h6"
                      style="background: linear-gradient(135deg, var(--primary), var(--info)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    @BrandText
                </span>
            </div>

            @if (ShowThemeToggle)
            {
                <div class="d-flex align-center gap-sm">
                    <UiTooltip Text="@ModeText" Position="TooltipPosition.Left">
                        <button type="button" class="ui-btn ui-btn-secondary ui-btn-sm"
                                style="border-radius: var(--radius-full); padding: 0.4rem 0.85rem;" aria-label="@ModeText" @onclick="ToggleTheme">
                            <span aria-hidden="true">@ModeIcon</span>
                            <span class="mode-theme-text">@(IsShowTextMode ? ModeText : string.Empty)</span>
                        </button>
                    </UiTooltip>
                </div>
            }
        </header>

        @if (TabsPosition == UiTabBarPosition.Top)
        {
            @TabBar
        }
    </div>

    <main>
        <article>
            @MainBody
        </article>
    </main>

    @if (ShowFooter)
    {
        <footer class="d-flex justify-center align-center p-md"
                style="background: var(--bg-surface); border-top: 1px solid var(--border-default);">
            @if (FooterText != string.Empty)
            {
                <span style="font-size: 0.85rem; color: var(--text-secondary);">
                    @(FooterText ?? $"© {DateTime.Now.Year} Waeses. All rights reserved.")
                </span>
            }
            @Footer
        </footer>
    }

    @if (TabsPosition == UiTabBarPosition.Bottom)
    {
        @TabBar
    }
</div>

@code {
    /// <summary>Nom de l'application, affiché dans l'en-tête.</summary>
    [Parameter] public string BrandText { get; set; } = "Waeses UI";
    /// <summary>Icône ou emoji devant le nom.</summary>
    [Parameter] public string? BrandIcon { get; set; } = "⚡";
    /// <summary>Affiche le bouton clair/sombre dans l'en-tête.</summary>
    [Parameter] public bool ShowThemeToggle { get; set; } = true;
    /// <summary>Indique si le mode sombre est actif.</summary>
    [Parameter] public bool IsDarkMode { get; set; }
    /// <summary>Appelé quand l'utilisateur change de mode.</summary>
    [Parameter] public EventCallback<bool> IsDarkModeChanged { get; set; }
    /// <summary>Indique si le texte (label) mode sombre est affiché.</summary>
    [Parameter] public bool IsShowTextMode { get; set; }
    /// <summary>Contenu de la page (le <c>Body</c> du layout Blazor).</summary>
    [Parameter] public RenderFragment? MainBody { get; set; }
    /// <summary>Contenu supplémentaire du pied de page.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }
    /// <summary>Affiche le pied de page (texte et fragment <see cref="Footer"/>). Faux par défaut : la barre d'onglets en tient lieu.</summary>
    [Parameter] public bool ShowFooter { get; set; }
    /// <summary>Texte du pied de page. Null : « © année Waeses. All rights reserved. » ; chaîne vide : aucun texte.</summary>
    [Parameter] public string? FooterText { get; set; }

    /// <summary>Onglets de la barre : libellé, icône et adresse de chaque page. La propriété <c>Group</c> des éléments est ignorée.</summary>
    [Parameter] public IEnumerable<NavigationItem>? NavigationItems { get; set; }
    /// <summary>Place de la barre d'onglets : <c>Bottom</c> (en bas de l'écran, défaut) ou <c>Top</c> (sous l'en-tête).</summary>
    [Parameter] public UiTabBarPosition TabsPosition { get; set; } = UiTabBarPosition.Bottom;
    /// <summary>Nom accessible de la barre d'onglets.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Navigation principale";

    string ModeText => IsDarkMode ? "Mode Clair" : "Mode Sombre";
    string ModeIcon => IsDarkMode ? "☀️" : "🌙";

    private string RootClass => CssBuilder.Default("ui-tablayout")
        .Add($"ui-tablayout-{TabsPosition.ToString().ToLowerInvariant()}")
        .Add(Class)
        .Build();

    private IEnumerable<NavigationItem> Items => NavigationItems ?? Array.Empty<NavigationItem>();

    // La barre est un fragment : le même balisage sert en haut et en bas, seule la classe CSS du conteneur change.
    private RenderFragment TabBar => @<nav class="ui-tablayout-tabs" aria-label="@AriaLabel">
        @foreach (var item in Items)
        {
            @if (item.Disabled)
            {
                <span @key="item.Href" class="ui-tablayout-tab ui-tablayout-tab-disabled" aria-disabled="true">
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <UiIcon Icon="@item.Icon" />
                    }
                    <span class="ui-tablayout-tab-label">@item.Text</span>
                </span>
            }
            else
            {
                <NavLink @key="item.Href" class="ui-tablayout-tab" href="@item.Href" Match="@item.Match">
                    @if (!string.IsNullOrEmpty(item.Icon))
                    {
                        <UiIcon Icon="@item.Icon" />
                    }
                    <span class="ui-tablayout-tab-label">@item.Text</span>
                </NavLink>
            }
        }
    </nav>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeThemeAsync();
            IsDarkMode = ThemeService.IsDarkMode;
            await IsDarkModeChanged.InvokeAsync(IsDarkMode);
            ThemeService.OnThemeChanged += HandleThemeChanged;
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
        IsDarkMode = ThemeService.IsDarkMode;
        await IsDarkModeChanged.InvokeAsync(IsDarkMode);
    }

    private async void HandleThemeChanged()
    {
        IsDarkMode = ThemeService.IsDarkMode;
        await IsDarkModeChanged.InvokeAsync(IsDarkMode);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
