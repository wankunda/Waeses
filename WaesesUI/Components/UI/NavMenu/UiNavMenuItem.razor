@namespace WaesesUI

@if (Disabled)
{
    <div class="nav-item px-3 nav-item-disabled" aria-disabled="true">
        <span class="nav-link">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <UiIcon Icon="@Icon" Size="UiSize.Sm" />
            }
            <span>@Text</span>
        </span>
    </div>
}
else
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="@Href" Match="@Match">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <UiIcon Icon="@Icon" Size="UiSize.Sm" />
            }
            <span>@Text</span>
        </NavLink>
    </div>
}

@code {
    /// <summary>Libellé du lien.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    /// <summary>Adresse du lien.</summary>
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    /// <summary>Icône affichée avant le libellé.</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Détermine quand le lien est actif : adresse exacte ou préfixe.</summary>
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    /// <summary>Lien visible mais non navigable.</summary>
    [Parameter] public bool Disabled { get; set; }
}