@namespace WaesesUI
@inherits UiComponentBase

<ol class="ui-stepper @Class" aria-label="@AriaLabel" style="@Style" @attributes="AdditionalAttributes">
    @foreach (var step in Steps.Select((value, index) => (value, index)))
    {
        var state = step.index < ActiveIndex || step.value.Completed ? "complete" : step.index == ActiveIndex ? "active" : "upcoming";
        <li class="ui-step ui-step-@state @(step.value.Disabled ? "disabled" : "")">
            <button type="button" disabled="@step.value.Disabled" aria-current="@(step.index == ActiveIndex ? "step" : null)" @onclick="() => SelectStep(step.index)">
                <span class="ui-step-number">@(step.value.Completed || step.index < ActiveIndex ? "✓" : step.index + 1)</span>
                <span class="ui-step-copy"><strong>@step.value.Title</strong>@if (!string.IsNullOrWhiteSpace(step.value.Description)) { <small>@step.value.Description</small> }</span>
            </button>
        </li>
    }
</ol>

@code {
    /// <summary>Étapes du parcours.</summary>
    [Parameter] public IReadOnlyList<UiStepItem> Steps { get; set; } = Array.Empty<UiStepItem>();
    /// <summary>Index de l'étape active (lié avec <c>bind-ActiveIndex</c>).</summary>
    [Parameter] public int ActiveIndex { get; set; }
    /// <summary>Appelé quand l'utilisateur choisit une autre étape.</summary>
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }
    /// <summary>Nom accessible de la liste d'étapes.</summary>
    [Parameter] public string AriaLabel { get; set; } = "Étapes";

    private Task SelectStep(int index) => ActiveIndexChanged.InvokeAsync(index);
}
