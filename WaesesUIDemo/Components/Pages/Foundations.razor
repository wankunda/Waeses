@page "/fondations"
@rendermode InteractiveServer
@inject IToastService ToastService
@inject IMessageBoxService MessageBoxService

<PageTitle>Fondations · WaesesUI</PageTitle>

<DemoPageHeader Eyebrow="01 · Fondations" Title="Les briques qui donnent le ton" Description="Commencez ici pour découvrir les primitives visuelles, les états de feedback et les compositions de contenu de WaesesUI." />

<section class="ui-grid ui-grid-cols-2">
    <UiCard Title="Actions et statuts" Subtitle="Des contrôles explicites, avec un état visible">
        <div class="ui-flex-row">
            <UiButton Text="Primaire" OnClick="ShowSuccess" />
            <UiButton Text="Secondaire" Variant="UiButtonVariant.Secondary" />
            <UiButton Text="Contour" Variant="UiButtonVariant.Outline" />
            <UiButton Text="Danger" Variant="UiButtonVariant.Danger" />
            <UiButton Text="Chargement" Loading="true" />
        </div>
        <div class="ui-flex-row mt-sm">
            <UiBadge Text="Stable" Color="UiColor.Success" />
            <UiBadge Text="En revue" Color="UiColor.Warning" />
            <UiBadge Text="Nouveau" Color="UiColor.Info" />
            <UiBadge Text="Bloqué" Color="UiColor.Danger" />
        </div>
    </UiCard>

    <UiCard Title="Feedback immédiat" Subtitle="Alertes, toast et confirmation">
        <div class="ui-flex-col">
            <UiAlert Title="Information" Message="Les composants sont consommables sans dépendance de design system externe." Color="UiColor.Info" Dismissible="true" />
            <div class="ui-flex-row mt-sm">
                <UiButton Text="Afficher un toast" Variant="UiButtonVariant.Success" OnClick="ShowToast" />
                <UiButton Text="Ouvrir une confirmation" Variant="UiButtonVariant.Outline" OnClick="ConfirmAction" />
            </div>
        </div>
    </UiCard>
</section>

<section class="ui-grid ui-grid-cols-2 mt-sm">
    <UiCard Title="Navigation locale" Subtitle="Onglets et accordéon">
        <UiTabs>
            <UiTabPanel Title="Aperçu" Icon="◈" Badge="1">
                <p class="text-secondary">Les onglets organisent plusieurs vues dans un même contexte.</p>
            </UiTabPanel>
            <UiTabPanel Title="API" Icon="⌘">
                <p class="text-secondary">Chaque composant expose des paramètres Razor explicites et typés.</p>
            </UiTabPanel>
        </UiTabs>
        <hr />
        <UiAccordion>
            <UiAccordionItem Title="Pourquoi une bibliothèque locale ?" IsOpen="true">Elle centralise les conventions visuelles, les états et l'accessibilité de l'application.</UiAccordionItem>
            <UiAccordionItem Title="Comment commencer ?">Référencez le projet, ajoutez les services et les assets, puis composez vos pages.</UiAccordionItem>
        </UiAccordion>
    </UiCard>

    <UiCard Title="Identité et présence" Subtitle="Avatars, tooltip et progression">
        <div class="ui-flex-row">
            <UiAvatar Initials="AW" Status="AvatarStatus.Online" Size="UiSize.Lg" BackgroundColor="#173f5f" />
            <UiAvatar Initials="ML" Status="AvatarStatus.Away" Size="UiSize.Lg" BackgroundColor="#ed553b" />
            <UiAvatarGroup ExtraCount="4">
                <UiAvatar Initials="JS" BackgroundColor="#20639b" />
                <UiAvatar Initials="PK" BackgroundColor="#3caea3" />
            </UiAvatarGroup>
            <UiTooltip Text="Un aperçu d'aide contextuelle"><UiButton Text="Survolez-moi" Variant="UiButtonVariant.Ghost" /></UiTooltip>
        </div>
        <div class="ui-flex-col mb-sm">
          <span>Chargement du catalogue</span><UiProgress Value="68" /></div>
        <div class="ui-flex-row gap-md"><UiSpinner Color="UiColor.Primary" /><UiSpinner Variant="UiSpinnerVariant.Pulse" Color="UiColor.Info" /></div>
    </UiCard>
</section>

<section class="ui-grid ui-grid-cols-2 mt-sm">
    <UiCard Title="Composants avancés" Subtitle="Modal, avatar-menu et icônes">
        <div class="ui-flex-row mt-sm">
            <UiButton Text="Ouvrir le modal" OnClick="OpenModal" />
            <UiAvatarMenu Initials="AM" Size="UiSize.Lg" BackgroundColor="#173f5f">
                <div class="ui-flex-col p-sm">
                    <strong>Alice Martin</strong>
                    <span>Administratrice</span>
                    <a href="/formulaires">Mon profil</a>
                    <a href="/">Se déconnecter</a>
                </div>
            </UiAvatarMenu>
            <UiIcon Icon="@Icons.Material.Filled.Home" Color="UiColor.Primary" Size="UiSize.Lg" Title="Accueil" />
            <UiIcon Icon="@Icons.Material.Filled.CheckCircle" Color="UiColor.Success" Size="UiSize.Lg" Title="Validé" />
        </div>
        <p class="text-secondary">`UiIcon` accepte les chemins SVG fournis par la bibliothèque et peut être coloré par `UiColor`.</p>
    </UiCard>

    <UiCard Title="UiSimpleLayout" Subtitle="Une composition autonome pour les écrans simples">
        <div class="ui-card">
            <UiSimpleLayout BrandText="Espace membre" BrandIcon="W" ShowThemeToggle="false">
                <MainBody>
                    <div class="ui-flex-col p-md">
                        <span class="text-primary fw-bold">Aperçu embarqué</span>
                        <strong>Un layout minimal avec son propre en-tête.</strong>
                        <span class="text-secondary">Utile pour une page de connexion ou un écran isolé.</span>
                    </div>
                </MainBody>
            </UiSimpleLayout>
        </div>
    </UiCard>
</section>

<UiModal @bind-IsOpen="_isModalOpen" Title="Modal WaesesUI" Size="UiSize.Md">
    <ChildContent>
        <p>Le composant gère le backdrop, la fermeture avec Échap, le focus et le verrouillage du défilement.</p>
        <p class="text-secondary">Le pied de page accepte n'importe quel fragment Razor.</p>
    </ChildContent>
    <Footer>
        <UiButton Text="Fermer" Variant="UiButtonVariant.Secondary" OnClick="CloseModal" />
        <UiButton Text="Compris" OnClick="CloseModal" />
    </Footer>
</UiModal>

@code {
    private bool _isModalOpen;

    private void OpenModal() => _isModalOpen = true;

    private void CloseModal() => _isModalOpen = false;

    private void ShowSuccess() => ToastService.ShowToast("L'action a été exécutée.", ToastType.Success, "Tout va bien");

    private void ShowToast() => ToastService.ShowToast("Le toast est fourni par IToastService.", ToastType.Info, "Démonstration");

    private async Task ConfirmAction()
    {
        var confirmed = await MessageBoxService.ShowAsync("Confirmer l'action", "Cette boîte est rendue par UiMessageBoxProvider.");
        if (confirmed)
        {
            ToastService.ShowToast("Confirmation reçue.", ToastType.Success);
        }
    }
}