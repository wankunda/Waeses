@page "/"
@rendermode InteractiveServer

<PageTitle>WaesesUI · Démonstration</PageTitle>

<div class="ui-container home-page">
<section class="home-hero">
	<div class="home-hero-copy">
		<div class="home-kicker"><UiIcon Icon="@Icons.Material.Filled.AutoGraph" Color="UiColor.Primary" Size="UiSize.Sm" /> Razor component library · .NET 10</div>
		<h1>Construire des interfaces nettes, composant par composant.</h1>
		<p class="text-secondary">Un catalogue vivant des contrôles WaesesUI, avec des exemples lisibles, interactifs et directement transposables dans vos applications Blazor.</p>
		<div class="ui-flex-row mt-md">
			<UiButton Text="Explorer les fondations" Href="/fondations" Icon="@Icons.Material.Filled.ArrowForward" Size="UiSize.Lg" />
			<UiButton Text="Voir les formulaires" Href="/formulaires" Variant="UiButtonVariant.Outline" Size="UiSize.Lg" />
			<UiButtonIcon Icon="@Icons.Material.Filled.Add" />
			<UiButtonIcon Icon="@Icons.Material.Filled.Add" Size="UiSize.Sm" />
			<UiButtonIcon Icon="@Icons.Material.Filled.Add" Size="UiSize.Lg" Variant="UiButtonVariant.Success" />
		</div>
	</div>
	<div class="home-dashboard mt-sm" aria-label="Aperçu des composants graphiques WaesesUI">
		<div class="home-dashboard-topline">
			<div><span class="text-secondary">Adoption du catalogue</span><strong>+24,8 %</strong></div>
			<UiBadge Text="En progression" Color="UiColor.Success" />
		</div>
		<UiLineChart Data="_activityData" Color="var(--primary)" AriaLabel="Progression de l'adoption du catalogue" />
		<div class="home-dashboard-footer">
			<div class="home-stat mt-xs"><UiIcon Icon="@Icons.Material.Filled.Code" Color="UiColor.Info" Size="UiSize.Sm" /><span><strong>20+</strong><small>composants</small></span></div>
			<div class="home-stat mt-xs"><UiIcon Icon="@Icons.Material.Filled.Category" Color="UiColor.Warning" Size="UiSize.Sm" /><span><strong>6</strong><small>familles</small></span></div>
			<UiDonutChart Data="_goalData" CenterLabel="72 %" CenterCaption="couvert" AriaLabel="72 pour cent des composants couverts" />
		</div>
	</div>
</section>

<section class="mt-lg">
	<div class="home-section-heading d-flex justify-space-between align-center">
		<div><span class="text-primary fw-bold">Parcours recommandé</span><h2>Apprendre par intention</h2></div>
		<span class="text-secondary">Chaque page isole une famille de composants.</span>
	</div>
	<div class="ui-grid ui-grid-cols-3">
		<UiCard Title="01 · Fondations" Subtitle="Les briques visuelles et feedback" Hoverable="true">
			<HeaderActions><UiIcon Icon="@Icons.Material.Filled.AutoGraph" Color="UiColor.Primary" Size="UiSize.Md" Title="Fondations" /></HeaderActions>
			<ChildContent>
				<p>Buttons, badges, avatars, alertes, onglets et accordéons pour composer une interface expressive.</p>
				<a class="home-card-link text-primary" href="/fondations">Ouvrir la page <UiIcon Icon="@Icons.Material.Filled.ArrowForward" Size="UiSize.Sm" /></a>
			</ChildContent>
		</UiCard>
		<UiCard Title="02 · Formulaires" Subtitle="Des saisies guidées et accessibles" Hoverable="true">
			<HeaderActions><UiIcon Icon="@Icons.Material.Filled.DataObject" Color="UiColor.Info" Size="UiSize.Md" Title="Formulaires" /></HeaderActions>
			<ChildContent>
				<p>Validation, sélecteurs, interrupteurs, curseurs, date/heure et upload de fichiers.</p>
				<a class="home-card-link text-primary" href="/formulaires">Ouvrir la page <UiIcon Icon="@Icons.Material.Filled.ArrowForward" Size="UiSize.Sm" /></a>
			</ChildContent>
		</UiCard>
		<UiCard Title="03 · Données" Subtitle="Présenter, filtrer et suivre" Hoverable="true">
			<HeaderActions><UiIcon Icon="@Icons.Material.Filled.Category" Color="UiColor.Success" Size="UiSize.Md" Title="Données" /></HeaderActions>
			<ChildContent>
				<p>Table triable et paginée, progression, images et interactions de confirmation.</p>
				<a class="home-card-link text-primary" href="/donnees">Ouvrir la page <UiIcon Icon="@Icons.Material.Filled.ArrowForward" Size="UiSize.Sm" /></a>
			</ChildContent>
		</UiCard>
	</div>
</section>
</div>

@code {
	private readonly IReadOnlyList<UiChartData> _activityData = new[]
	{
		new UiChartData("Lun", 34),
		new UiChartData("Mar", 46),
		new UiChartData("Mer", 42),
		new UiChartData("Jeu", 61),
		new UiChartData("Ven", 76),
		new UiChartData("Sam", 88)
	};

	private readonly IReadOnlyList<UiChartData> _goalData = new[]
	{
		new UiChartData("Couvert", 72, "var(--success)"),
		new UiChartData("À venir", 28, "var(--bg-surface-tertiary)")
	};
}
