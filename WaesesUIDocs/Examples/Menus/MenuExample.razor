<div class="ui-flex-row" style="align-items: center; flex-wrap: wrap; gap: 1rem;">
    <UiMenu AriaLabel="Actions du document" @bind-IsOpen="_open">
        <Trigger><span>Actions ▾</span></Trigger>
        <ChildContent>
            <button type="button" @onclick="@(() => _last = "Renommer")">Renommer</button>
            <button type="button" @onclick="@(() => _last = "Dupliquer")">Dupliquer</button>
            <button type="button" disabled>Archiver (indisponible)</button>
            <a href="https://github.com/wankunda/Waeses" target="_blank" rel="noopener noreferrer">Ouvrir le dépôt</a>
        </ChildContent>
    </UiMenu>

    <span class="text-secondary">Dernière action : <strong>@_last</strong></span>
</div>

@code {
    private bool _open;
    private string _last = "aucune";
}
