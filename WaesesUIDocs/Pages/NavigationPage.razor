@page "/composants/navigation"

<DocPage Href="composants/navigation">
    <DocSection Title="Menu latéral" Description="`UiNavMenu` est le menu de l'application (celui de cette documentation). Il se règle avec une liste de `NavigationItem` : les liens d'un même `Group` s'affichent en retrait sous le titre du groupe. `CollapsibleGroups` rend les groupes repliables, et `Groups` (des `NavigationGroup`) règle chaque groupe à part, pour mêler groupes fixes et repliables. Il se replie en tiroir sur petit écran et accepte `HeaderContent` pour une recherche. Son état est local par défaut ou contrôlable avec `@@bind-IsOpen`. Il démarre fermé sur mobile et reste visible sur grand écran. Il occupe le bord de l'écran : il est donc présenté en code plutôt qu'en exemple vivant.">
        <UiCodeBlock Code="@Snippets.NavMenuUsage" Language="razor" />
        <div class="api-table-wrap">
            <table class="ui-table ui-table-compact">
                <caption class="api-caption">NavigationItem</caption>
                <thead><tr><th scope="col">Propriété</th><th scope="col">Rôle</th></tr></thead>
                <tbody>
                    <tr><td><code>Text</code></td><td>Libellé du lien.</td></tr>
                    <tr><td><code>Href</code></td><td>Adresse du lien.</td></tr>
                    <tr><td><code>Icon</code></td><td>Icône affichée avant le libellé.</td></tr>
                    <tr><td><code>Match</code></td><td><code>All</code> (adresse exacte) ou <code>Prefix</code> (défaut) : quand le lien est actif.</td></tr>
                    <tr><td><code>Disabled</code></td><td>Lien visible mais non navigable.</td></tr>
                    <tr><td><code>Group</code></td><td>Nom du groupe : ses liens s'affichent en retrait sous son titre (les éléments d'un même groupe doivent se suivre). Sans groupe, le lien s'affiche simplement.</td></tr>
                </tbody>
            </table>
        </div>
        <div class="api-table-wrap">
            <table class="ui-table ui-table-compact">
                <caption class="api-caption">NavigationGroup</caption>
                <thead><tr><th scope="col">Propriété</th><th scope="col">Rôle</th></tr></thead>
                <tbody>
                    <tr><td><code>Name</code></td><td>Nom du groupe, identique à <code>NavigationItem.Group</code>.</td></tr>
                    <tr><td><code>Collapsible</code></td><td><code>true</code> : repliable, <code>false</code> : fixe. Laissé à <code>null</code>, le groupe suit <code>CollapsibleGroups</code> du menu.</td></tr>
                    <tr><td><code>InitiallyCollapsed</code></td><td>Groupe replié au premier affichage. Le groupe de la page active reste toujours ouvert.</td></tr>
                </tbody>
            </table>
        </div>
    </DocSection>

    <DocSection Title="Barre de navigation" Description="`UiNavBar` est une barre horizontale : le nom de l'application à gauche, les liens (`NavigationItem`) à droite, puis `EndContent` pour un bouton ou un menu de compte. Sous la largeur `CollapseBelow` (768 px par défaut), les liens se replient derrière un bouton hamburger ; le panneau se ferme au choix d'un lien, avec `Échap` ou lors d'un changement de breakpoint. `IsOpen` / `IsOpenChanged` permettent de contrôler son état depuis le parent. `BrandContent` remplace le nom par un logo.">
        <DocExample Example="typeof(NavBarExample)" />
    </DocSection>

    <DocSection Title="Fil d'Ariane" Description="`UiBreadcrumbs` indique où l'on se trouve. Le dernier élément, sans adresse, est la page courante (`aria-current=&quot;page&quot;`).">
        <DocExample Example="typeof(BreadcrumbsExample)" />
    </DocSection>

    <DocSection Title="Étapes" Description="`UiStepper` présente un parcours en plusieurs étapes ; l'étape active se lie avec `ActiveIndex`.">
        <DocExample Example="typeof(StepperExample)" />
    </DocSection>

    <DocSection Title="API">
        <ApiTable Component="typeof(UiNavMenu)" />
        <ApiTable Component="typeof(UiNavBar)" />
        <ApiTable Component="typeof(UiBreadcrumbs)" />
        <ApiTable Component="typeof(UiStepper)" />
    </DocSection>
</DocPage>
