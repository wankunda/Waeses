@page "/composants/avatars-badges-puces"

<DocPage Href="composants/avatars-badges-puces">
    <DocSection Title="Avatars" Description="`UiAvatar` affiche une image ou, à défaut, des initiales ; `Status` ajoute une pastille de présence. Donnez un `Alt` : il nomme l'avatar. `UiAvatarGroup` les superpose et ajoute « +N ».">
        <DocExample Example="typeof(AvatarsExample)" />
    </DocSection>

    <DocSection Title="Badges et puces" Description="`UiBadge` signale un état ou un compteur ; `UiChip` est une étiquette que l'on peut retirer. `Variant` (plein, contour, teinté) s'ajoute à `Color`.">
        <DocExample Example="typeof(BadgesChipsExample)" />
    </DocSection>

    <DocSection Title="Icônes" Description="`UiIcon` affiche un SVG de la classe `Icons` (Material et icônes de marques). Sans `Title`, l'icône est décorative et masquée aux lecteurs d'écran.">
        <DocExample Example="typeof(IconsExample)" />
    </DocSection>

    <DocSection Title="API">
        <ApiTable Component="typeof(UiAvatar)" />
        <ApiTable Component="typeof(UiAvatarGroup)" />
        <ApiTable Component="typeof(UiBadge)" />
        <ApiTable Component="typeof(UiChip)" />
        <ApiTable Component="typeof(UiIcon)" />
    </DocSection>
</DocPage>
